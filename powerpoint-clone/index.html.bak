    </div>

    <!-- Mobile Bottom Bar -->
    <div class="ppt-mobile-bottom-bar">
        <button onclick="addSlide()" title="Nuova diapositiva"><i class="fas fa-plus-square"></i></button>
        <button onclick="toggleMobileThumbs()" title="Diapositive"><i class="fas fa-layer-group"></i></button>
        <div class="mob-sep"></div>
        <button onclick="addTextBox()" title="Testo"><i class="fas fa-font"></i></button>
        <button onclick="addShape('rectangle')" title="Forma"><i class="fas fa-square"></i></button>
        <button onclick="document.getElementById('mobileImageUpload').click()" title="Immagine"><i class="fas fa-image"></i></button>
        <input type="file" id="mobileImageUpload" accept="image/*" style="display:none" onchange="addImage(event)">
        <div class="mob-sep"></div>
        <button onclick="formatText('bold')" title="Grassetto"><i class="fas fa-bold"></i></button>
        <button onclick="formatText('italic')" title="Corsivo"><i class="fas fa-italic"></i></button>
        <button onclick="formatText('underline')" title="Sottolineato"><i class="fas fa-underline"></i></button>
        <input type="color" id="mobTextColor" value="#000000" onchange="changeTextColor(this.value)" title="Colore testo">
        <div class="mob-sep"></div>
        <button onclick="startSlideshow()" title="Presenta"><i class="fas fa-play"></i></button>
    </div>

    <!-- Mobile Menu Overlay -->
    <div class="ppt-mobile-menu-overlay" id="mobileMenuOverlay" onclick="closeMobileMenu(event)">
        <div class="ppt-mobile-menu">
            <div class="ppt-mobile-menu-item" onclick="saveToServer(); closeMobileMenu();">
                <i class="fas fa-cloud-upload-alt"></i> Salva sul server
            </div>
            <div class="ppt-mobile-menu-item" onclick="loadFromServerList(); closeMobileMenu();">
                <i class="fas fa-cloud-download-alt"></i> Carica dal server
            </div>
            <div class="ppt-mobile-menu-item" onclick="downloadPresentation(); closeMobileMenu();">
                <i class="fas fa-download"></i> Scarica JSON
            </div>
            <div class="ppt-mobile-menu-item" onclick="document.getElementById('fileInput').click(); closeMobileMenu();">
                <i class="fas fa-folder-open"></i> Apri file locale
            </div>
            <div class="ppt-mobile-menu-item" onclick="exportAsPDF(); closeMobileMenu();">
                <i class="fas fa-file-pdf"></i> Esporta PDF
            </div>
            <div class="ppt-mobile-menu-item" onclick="printPresentation(); closeMobileMenu();">
                <i class="fas fa-print"></i> Stampa
            </div>
            <div class="ppt-mobile-menu-item" onclick="deleteSlide(); closeMobileMenu();">
                <i class="fas fa-trash"></i> Elimina diapositiva
            </div>
        </div>
    </div>

    <!-- Mobile Thumbnails Overlay -->
    <div class="ppt-mobile-thumbs-overlay" id="mobileThumbsOverlay" onclick="closeMobileThumbs(event)">
        <div class="ppt-mobile-thumbs-panel" onclick="event.stopPropagation()">
            <div class="ppt-mobile-thumbs-header">
                <span>Diapositive</span>
                <button onclick="document.getElementById('mobileThumbsOverlay').classList.remove('show')"><i class="fas fa-times"></i></button>
            </div>
            <div class="ppt-mobile-thumbs-actions">
                <button onclick="addSlide(); renderMobileThumbnails();" title="Nuova"><i class="fas fa-plus"></i>Nuova</button>
                <button onclick="duplicateCurrentSlide(); renderMobileThumbnails();" title="Duplica"><i class="fas fa-copy"></i>Duplica</button>
                <button onclick="deleteSlide(); renderMobileThumbnails();" title="Elimina"><i class="fas fa-trash"></i>Elimina</button>
            </div>
            <div class="ppt-mobile-thumbs-list" id="mobileThumbsPanel"></div>
        </div>
    </div>

    <!-- Comments Panel -->
    <div class="comments-overlay" id="commentsOverlay" onclick="toggleCommentsPanel()"></div>
    <div class="comments-panel" id="commentsPanel">
        <div class="comments-panel-header">
            <span>Commenti</span>
            <button onclick="toggleCommentsPanel()"><i class="fas fa-times"></i></button>
        </div>
        <div class="comments-panel-body" id="commentsList">
            <p style="color:#a19f9d; text-align:center; margin-top:40px;">Nessun commento ancora.<br>Aggiungi il primo commento!</p>
        </div>
        <div class="comments-panel-footer">
            <input type="text" id="commentInput" placeholder="Aggiungi un commento..." onkeydown="if(event.key==='Enter') addComment()">
            <button onclick="addComment()">Invia</button>
        </div>
    </div>

    <!-- Share Modal -->
    <div class="share-modal-overlay" id="shareModalOverlay" onclick="if(event.target===this) this.classList.remove('open')">
        <div class="share-modal">
            <h3>Condividi presentazione</h3>
            <p style="font-size:14px; color:#605e5c; margin-bottom:12px;">Condividi il link della presentazione salvata sul server:</p>
            <div class="share-link-box">
                <input type="text" id="shareLink" readonly value="" placeholder="Salva prima la presentazione sul server">
                <button onclick="copyShareLink()"><i class="fas fa-copy"></i> Copia</button>
            </div>
            <p style="font-size:13px; color:#a19f9d;">Oppure salva sul server per generare un link condivisibile.</p>
            <button class="share-close" onclick="document.getElementById('shareModalOverlay').classList.remove('open')">Chiudi</button>
        </div>
    </div>

    <!-- Toast -->
    <div class="ppt-toast" id="pptToast"></div>

    <!-- Server Load Modal -->
    <div class="ppt-server-modal-overlay" id="serverModalOverlay">
        <div class="ppt-server-modal">
            <h3>Presentazioni sul server</h3>
            <div id="serverFileList"></div>
            <button class="ppt-server-modal-close" onclick="document.getElementById('serverModalOverlay').classList.remove('show')">Chiudi</button>
        </div>
    </div>

    <!-- Bottom bar -->
    <div class="bottom-bar">
        <div class="bottom-left">
            <span>Diapositiva <span id="slideNumber">1</span> di <span id="totalSlides">1</span></span>
            <span>Italiano (Italia)</span>
        </div>
        <div class="bottom-right">
            <button class="zoom-btn" onclick="zoom(-10)">−</button>
            <input type="range" class="zoom-slider" min="50" max="200" value="100" id="zoomSlider" onchange="updateZoom(this.value)">
            <button class="zoom-btn" onclick="zoom(10)">+</button>
            <span id="zoomLabel">100%</span>
            <button class="zoom-btn" onclick="fitToWindow()">⊞</button>
        </div>
    </div>

    <input type="file" id="fileInput" accept=".json" style="display:none" onchange="loadPresentation(event)">

    <script>
        let presentation = {
            slides: [],
            currentSlide: 0,
            name: 'Presentation 1'
        };

        let selectedElement = null;
        let isDragging = false;
        let dragOffset = { x: 0, y: 0 };
        let zoomLevel = 100;
        let currentTab = 'home';

        function init() {
            addSlide();
            if (typeof OfficeLauncher !== 'undefined') {
                document.addEventListener('click', function(e) {
                    if (!e.target.closest('.waffle-btn') && !e.target.closest('.office-launcher-panel')) {
                        OfficeLauncher.close();
                    }
                });
            }
        }


        function switchTab(tab) {
            document.querySelectorAll('.ribbon-tab').forEach(t => t.classList.remove('active'));
            const activeTab = document.querySelector(`.ribbon-tab[onclick*="'${tab}'"]`);
            if (activeTab) activeTab.classList.add('active');
            document.querySelectorAll('.ribbon-content').forEach(r => r.classList.add('hidden'));
            const ribbonId = 'ribbon-' + tab;
            const ribbon = document.getElementById(ribbonId);
            if (ribbon) ribbon.classList.remove('hidden');
            currentTab = tab;
        }

        // Undo/Redo system
        let undoHistory = [];
        let redoHistory = [];

        function saveState() {
            undoHistory.push(JSON.stringify(presentation));
            if (undoHistory.length > 30) undoHistory.shift();
            redoHistory = [];
        }

        function undo() {
            if (undoHistory.length === 0) { showToast('Niente da annullare'); return; }
            redoHistory.push(JSON.stringify(presentation));
            const prev = undoHistory.pop();
            presentation = JSON.parse(prev);
            document.getElementById('docTitle').value = presentation.name;
            syncMobileTitle();
            renderThumbnails();
            renderCurrentSlide();
            updateSlideCounter();
            showToast('Annullato');
        }

        function redo() {
            if (redoHistory.length === 0) { showToast('Niente da ripristinare'); return; }
            undoHistory.push(JSON.stringify(presentation));
            const next = redoHistory.pop();
            presentation = JSON.parse(next);
            document.getElementById('docTitle').value = presentation.name;
            syncMobileTitle();
            renderThumbnails();
            renderCurrentSlide();
            updateSlideCounter();
            showToast('Ripristinato');
        }

        function syncMobileTitle() {
            const mob = document.getElementById('mobDocTitle');
            if (mob) mob.value = presentation.name;
        }

        function addSlide() {
            saveState();
            const slide = {
                id: Date.now(),
                elements: [
                    {
                        id: Date.now() + 1,
                        type: 'text',
                        x: 60,
                        y: 100,
                        width: 840,
                        height: 120,
                        content: 'Fare clic per inserire il titolo',
                        fontSize: 44,
                        color: '#000000',
                        bgColor: 'transparent',
                        bold: false,
                        italic: false,
                        underline: false,
                        fontFamily: 'Calibri',
                        isPlaceholder: true
                    },
                    {
                        id: Date.now() + 2,
                        type: 'text',
                        x: 60,
                        y: 280,
                        width: 840,
                        height: 200,
                        content: 'Fare clic per inserire il sottotitolo',
                        fontSize: 20,
                        color: '#000000',
                        bgColor: 'transparent',
                        bold: false,
                        italic: false,
                        underline: false,
                        fontFamily: 'Calibri',
                        isPlaceholder: true
                    }
                ],
                background: '#ffffff'
            };
            presentation.slides.push(slide);
            presentation.currentSlide = presentation.slides.length - 1;
            renderThumbnails();
            renderCurrentSlide();
            updateSlideCounter();
        }

        function deleteSlide() {
            saveState();
            if (presentation.slides.length > 1) {
                presentation.slides.splice(presentation.currentSlide, 1);
                if (presentation.currentSlide >= presentation.slides.length) {
                    presentation.currentSlide = presentation.slides.length - 1;
                }
                renderThumbnails();
                renderCurrentSlide();
                updateSlideCounter();
            } else {
                alert('Devi avere almeno una diapositiva!');
            }
        }

        function renderThumbnails() {
            const panel = document.getElementById('thumbnailsPanel');
            panel.innerHTML = '';
            presentation.slides.forEach((slide, index) => {
                const thumb = document.createElement('div');
                thumb.className = 'slide-thumb' + (index === presentation.currentSlide ? ' active' : '');
                thumb.innerHTML = `<div class="slide-thumb-number">${index + 1}</div>`;
                thumb.onclick = () => {
                    presentation.currentSlide = index;
                    renderThumbnails();
                    renderCurrentSlide();
                    updateSlideCounter();
                };
                panel.appendChild(thumb);
            });
        }

        function renderCurrentSlide() {
            const canvas = document.getElementById('slideCanvas');
            const slide = presentation.slides[presentation.currentSlide];
            canvas.innerHTML = '';
            canvas.style.background = slide.background;
            
            slide.elements.forEach(elem => {
                const div = document.createElement('div');
                div.className = 'slide-element';
                div.dataset.id = elem.id;
                div.style.left = elem.x + 'px';
                div.style.top = elem.y + 'px';
                div.style.width = elem.width + 'px';
                div.style.height = elem.height + 'px';

                if (elem.type === 'text') {
                    div.className += ' text-element';
                    if (elem.isPlaceholder) {
                        div.className += ' text-placeholder';
                    }
                    div.contentEditable = 'false';
                    div.innerHTML = elem.content;
                    div.style.fontSize = elem.fontSize + 'px';
                    div.style.color = elem.color;
                    div.style.backgroundColor = elem.bgColor;
                    div.style.fontWeight = elem.bold ? 'bold' : 'normal';
                    div.style.fontStyle = elem.italic ? 'italic' : 'normal';
                    div.style.textDecoration = elem.underline ? 'underline' : 'none';
                    div.style.fontFamily = elem.fontFamily || 'Calibri';

                    // Doppio click per entrare in modalità editing testo
                    div.ondblclick = (e) => {
                        e.stopPropagation();
                        div.contentEditable = 'true';
                        div.focus();
                        div.style.cursor = 'text';
                        if (elem.isPlaceholder) {
                            div.innerHTML = '';
                            div.classList.remove('text-placeholder');
                            elem.isPlaceholder = false;
                        }
                    };

                    div.onblur = () => {
                        div.contentEditable = 'false';
                        div.style.cursor = 'move';
                        elem.content = div.innerHTML;
                        if (div.innerHTML.trim() === '') {
                            div.innerHTML = elem.content = 'Fare clic per inserire testo';
                            elem.isPlaceholder = true;
                            div.classList.add('text-placeholder');
                        }
                    };
                } else if (elem.type === 'shape') {
                    div.className += ' shape-element';
                    div.style.backgroundColor = elem.bgColor;
                    if (elem.shape === 'circle') {
                        div.style.borderRadius = '50%';
                    }
                } else if (elem.type === 'image') {
                    div.className += ' image-element';
                    div.innerHTML = `<img src="${elem.src}" alt="image">`;
                }

                div.onclick = (e) => {
                    e.stopPropagation();
                    selectElement(div);
                };

                div.onmousedown = (e) => {
                    if (e.target.closest('.resize-handle')) return;
                    if (div.contentEditable === 'true' && document.activeElement === div) return;
                    e.preventDefault();
                    startDrag(e, div);
                };

                addTouchDrag(div, elem);
                addResizeHandles(div, elem);

                canvas.appendChild(div);
            });
        }

        function selectElement(elem) {
            if (selectedElement) {
                selectedElement.classList.remove('selected');
            }
            selectedElement = elem;
            elem.classList.add('selected');
        }

        function startDrag(e, elem) {
            isDragging = true;
            const rect = elem.getBoundingClientRect();
            const canvas = document.getElementById('slideCanvas').getBoundingClientRect();
            dragOffset.x = e.clientX - rect.left;
            dragOffset.y = e.clientY - rect.top;

            document.onmousemove = (e) => {
                if (isDragging) {
                    const x = e.clientX - canvas.left - dragOffset.x;
                    const y = e.clientY - canvas.top - dragOffset.y;
                    elem.style.left = x + 'px';
                    elem.style.top = y + 'px';
                    
                    const id = elem.dataset.id;
                    const slide = presentation.slides[presentation.currentSlide];
                    const element = slide.elements.find(e => e.id == id);
                    element.x = x;
                    element.y = y;
                }
            };

            document.onmouseup = () => {
                isDragging = false;
                document.onmousemove = null;
                document.onmouseup = null;
            };
        }

        function addTextBox() {
            saveState();
            const element = {
                id: Date.now(),
                type: 'text',
                x: 200,
                y: 200,
                width: 400,
                height: 100,
                content: 'Inserisci testo qui',
                fontSize: 18,
                color: '#000000',
                bgColor: 'transparent',
                bold: false,
                italic: false,
                underline: false,
                fontFamily: 'Calibri'
            };
            presentation.slides[presentation.currentSlide].elements.push(element);
            renderCurrentSlide();
        }

        function addShape(shape) {
            saveState();
            const element = {
                id: Date.now(),
                type: 'shape',
                shape: shape,
                x: 300,
                y: 200,
                width: 200,
                height: 150,
                bgColor: '#4472c4'
            };
            presentation.slides[presentation.currentSlide].elements.push(element);
            renderCurrentSlide();
        }

        function addImage(event) {
            const file = event.target.files[0];
            if (file) {
                saveState();
                const reader = new FileReader();
                reader.onload = (e) => {
                    const element = {
                        id: Date.now(),
                        type: 'image',
                        x: 200,
                        y: 100,
                        width: 400,
                        height: 300,
                        src: e.target.result
                    };
                    presentation.slides[presentation.currentSlide].elements.push(element);
                    renderCurrentSlide();
                };
                reader.readAsDataURL(file);
            }
        }

        function formatText(format) {
            if (selectedElement && selectedElement.classList.contains('text-element')) {
                saveState();
                const id = selectedElement.dataset.id;
                const slide = presentation.slides[presentation.currentSlide];
                const element = slide.elements.find(e => e.id == id);
                
                element[format] = !element[format];
                renderCurrentSlide();
            }
        }

        function changeFontSize(size) {
            if (selectedElement && selectedElement.classList.contains('text-element')) {
                saveState();
                const id = selectedElement.dataset.id;
                const slide = presentation.slides[presentation.currentSlide];
                const element = slide.elements.find(e => e.id == id);
                element.fontSize = parseInt(size);
                renderCurrentSlide();
            }
        }

        function changeFontFamily(family) {
            if (selectedElement && selectedElement.classList.contains('text-element')) {
                saveState();
                const id = selectedElement.dataset.id;
                const slide = presentation.slides[presentation.currentSlide];
                const element = slide.elements.find(e => e.id == id);
                element.fontFamily = family;
                renderCurrentSlide();
            }
        }

        function changeTextColor(color) {
            if (selectedElement && selectedElement.classList.contains('text-element')) {
                saveState();
                const id = selectedElement.dataset.id;
                const slide = presentation.slides[presentation.currentSlide];
                const element = slide.elements.find(e => e.id == id);
                element.color = color;
                renderCurrentSlide();
            }
        }

        function changeBgColor(color) {
            if (selectedElement) {
                saveState();
                const id = selectedElement.dataset.id;
                const slide = presentation.slides[presentation.currentSlide];
                const element = slide.elements.find(e => e.id == id);
                element.bgColor = color;
                renderCurrentSlide();
            }
        }

        function applyDesign(design) {
            saveState();
            const slide = presentation.slides[presentation.currentSlide];
            const designs = {
                'gradient1': 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
                'gradient2': 'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
                'gradient3': 'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',
                'gradient4': 'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)'
            };
            slide.background = designs[design] || '#ffffff';
            renderCurrentSlide();
        }

        function updateSlideCounter() {
            document.getElementById('slideNumber').textContent = presentation.currentSlide + 1;
            document.getElementById('totalSlides').textContent = presentation.slides.length;
        }

        function zoom(delta) {
            zoomLevel = Math.max(50, Math.min(200, zoomLevel + delta));
            document.getElementById('zoomSlider').value = zoomLevel;
            updateZoom(zoomLevel);
        }

        function updateZoom(value) {
            zoomLevel = parseInt(value);
            const label = document.getElementById('zoomLabel');
            if (label) label.textContent = zoomLevel + '%';
            const canvas = document.getElementById('slideCanvas');
            canvas.style.transform = `scale(${zoomLevel / 100})`;
            canvas.style.transformOrigin = 'center center';
        }

        function toggleDesigner() {
            const panel = document.querySelector('.designer-panel');
            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        }

        function downloadPresentation() {
            const dataStr = JSON.stringify(presentation, null, 2);
            const dataBlob = new Blob([dataStr], { type: 'application/json' });
            const url = URL.createObjectURL(dataBlob);
            const link = document.createElement('a');
            link.href = url;
            link.download = presentation.name + '.json';
            link.click();
            URL.revokeObjectURL(url);
        }

        function loadPresentation(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    try {
                        presentation = JSON.parse(e.target.result);
                        document.getElementById('docTitle').value = presentation.name;
                        renderThumbnails();
                        renderCurrentSlide();
                        updateSlideCounter();
                    } catch (error) {
                        alert('Errore nel caricamento del file');
                    }
                };
                reader.readAsText(file);
            }
        }

        // Toast notification
        function showToast(msg) {
            const t = document.getElementById('pptToast');
            t.textContent = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2500);
        }

        // Server save/load functions
        async function saveToServer() {
            const filename = (presentation.name || 'Presentation 1').replace(/[^a-zA-Z0-9_\- ]/g, '') + '.json';
            try {
                const response = await fetch('save.php', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ filename: filename, data: presentation })
                });
                const result = await response.json();
                if (result.success) {
                    showToast('Salvato sul server con successo!');
                } else {
                    showToast('Errore: ' + (result.message || 'salvataggio fallito'));
                }
            } catch (error) {
                console.error('Errore salvataggio server:', error);
                showToast('Server non raggiungibile, scarico il file...');
                downloadPresentation();
            }
        }

        async function loadFromServerList() {
            try {
                const response = await fetch('list_presentations.php');
                const files = await response.json();
                const listDiv = document.getElementById('serverFileList');
                listDiv.innerHTML = '';
                if (!files || files.length === 0) {
                    listDiv.innerHTML = '<p style="color:#605e5c;font-size:14px;">Nessuna presentazione trovata sul server.</p>';
                } else {
                    files.forEach(f => {
                        const item = document.createElement('div');
                        item.className = 'ppt-server-modal-item';
                        item.innerHTML = `<span onclick="loadFromServer('${f}')">${f}</span><button class="delete-btn" onclick="event.stopPropagation(); deleteFromServer('${f}')" title="Elimina"><i class="fas fa-trash"></i></button>`;
                        listDiv.appendChild(item);
                    });
                }
                document.getElementById('serverModalOverlay').classList.add('show');
            } catch (error) {
                showToast('Impossibile caricare la lista dal server');
            }
        }

        async function loadFromServer(filename) {
            try {
                const response = await fetch('load_presentation.php', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ filename: filename })
                });
                const result = await response.json();
                if (result.success && result.data) {
                    saveState();
                    presentation = result.data;
                    document.getElementById('docTitle').value = presentation.name || 'Presentation';
                    syncMobileTitle();
                    renderThumbnails();
                    renderCurrentSlide();
                    updateSlideCounter();
                    document.getElementById('serverModalOverlay').classList.remove('show');
                    showToast('Presentazione caricata!');
                } else {
                    showToast('Errore: ' + (result.message || 'caricamento fallito'));
                }
            } catch (error) {
                showToast('Errore nel caricamento dal server');
            }
        }

        async function deleteFromServer(filename) {
            if (!confirm('Eliminare "' + filename + '" dal server?')) return;
            try {
                const response = await fetch('delete_presentation.php', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ filename: filename })
                });
                const result = await response.json();
                if (result.success) {
                    showToast('Eliminato dal server');
                    loadFromServerList();
                } else {
                    showToast('Errore eliminazione');
                }
            } catch (error) {
                showToast('Errore comunicazione server');
            }
        }

        // Print function using Blob URL
        function printPresentation() {
            const slide = presentation.slides[presentation.currentSlide];
            let html = '<!DOCTYPE html><html><head><title>Stampa</title><style>';
            html += 'body{margin:0;padding:20px;font-family:Calibri,sans-serif;}';
            html += '.slide{width:100%;max-width:960px;aspect-ratio:16/9;position:relative;margin:0 auto 40px;page-break-after:always;border:1px solid #ccc;overflow:hidden;}';
            html += '.elem{position:absolute;}';
            html += '@media print{body{padding:0;}.slide{border:none;}}';
            html += '</style></head><body>';
            presentation.slides.forEach((s, i) => {
                html += `<div class="slide" style="background:${s.background}">`;
                s.elements.forEach(el => {
                    let style = `left:${(el.x/960)*100}%;top:${(el.y/580)*100}%;width:${(el.width/960)*100}%;`;
                    if (el.type === 'text') {
                        style += `font-size:${el.fontSize}px;color:${el.color};font-family:${el.fontFamily || 'Calibri'};`;
                        if (el.bold) style += 'font-weight:bold;';
                        if (el.italic) style += 'font-style:italic;';
                        if (el.underline) style += 'text-decoration:underline;';
                        if (el.bgColor && el.bgColor !== 'transparent') style += `background:${el.bgColor};`;
                        html += `<div class="elem" style="${style}">${el.content}</div>`;
                    } else if (el.type === 'shape') {
                        style += `height:${(el.height/580)*100}%;background:${el.bgColor};`;
                        if (el.shape === 'circle') style += 'border-radius:50%;';
                        html += `<div class="elem" style="${style}"></div>`;
                    } else if (el.type === 'image') {
                        style += `height:${(el.height/580)*100}%;`;
                        html += `<div class="elem" style="${style}"><img src="${el.src}" style="width:100%;height:100%;object-fit:contain;"></div>`;
                    }
                });
                html += '</div>';
            });
            html += '</body></html>';
            const blob = new Blob([html], { type: 'text/html' });
            const url = URL.createObjectURL(blob);
            const win = window.open(url, '_blank');
            if (win) {
                win.addEventListener('load', () => { win.print(); });
            }
            setTimeout(() => URL.revokeObjectURL(url), 10000);
        }

        // Slideshow
        function startSlideshow() {
            const el = document.documentElement;
            if (el.requestFullscreen) el.requestFullscreen();
            else if (el.webkitRequestFullscreen) el.webkitRequestFullscreen();
            showToast('Premi ESC per uscire dalla presentazione');
        }

        // Comments
        let comments = JSON.parse(localStorage.getItem('ppt_comments') || '[]');

        function toggleCommentsPanel() {
            document.getElementById('commentsPanel').classList.toggle('open');
            document.getElementById('commentsOverlay').classList.toggle('open');
            renderComments();
        }

        function renderComments() {
            const list = document.getElementById('commentsList');
            if (comments.length === 0) {
                list.innerHTML = '<p style="color:#a19f9d; text-align:center; margin-top:40px;">Nessun commento ancora.<br>Aggiungi il primo commento!</p>';
                return;
            }
            list.innerHTML = comments.map((c, i) => `
                <div class="comment-item">
                    <div class="comment-meta">Utente &bull; ${c.date} <button onclick="deleteComment(${i})" style="float:right;background:none;border:none;cursor:pointer;color:#a19f9d;" title="Elimina"><i class="fas fa-trash"></i></button></div>
                    <div class="comment-text">${c.text}</div>
                </div>
            `).join('');
        }

        function addComment() {
            const input = document.getElementById('commentInput');
            const text = input.value.trim();
            if (!text) return;
            comments.push({
                text: text,
                date: new Date().toLocaleString('it-IT')
            });
            localStorage.setItem('ppt_comments', JSON.stringify(comments));
            input.value = '';
            renderComments();
        }

        function deleteComment(index) {
            comments.splice(index, 1);
            localStorage.setItem('ppt_comments', JSON.stringify(comments));
            renderComments();
        }

        // Check for updates
        function checkForUpdates() {
            showToast('Stai utilizzando la versione più recente!');
        }

        // Edit mode toggle
        let editMode = true;
        function toggleEditMode() {
            editMode = !editMode;
            const canvas = document.getElementById('slideCanvas');
            if (editMode) {
                canvas.style.pointerEvents = 'auto';
                showToast('Modalità modifica attivata');
            } else {
                canvas.style.pointerEvents = 'none';
                if (selectedElement) {
                    selectedElement.classList.remove('selected');
                    selectedElement = null;
                }
                showToast('Modalità sola lettura attivata');
            }
        }

        // Share
        function sharePresentation() {
            const modal = document.getElementById('shareModalOverlay');
            const linkInput = document.getElementById('shareLink');
            const filename = presentation.name.replace(/[^a-zA-Z0-9_-]/g, '_') + '.json';
            linkInput.value = window.location.origin + '/saved_presentations/' + filename;
            modal.classList.add('open');
        }

        function copyShareLink() {
            const input = document.getElementById('shareLink');
            input.select();
            document.execCommand('copy');
            showToast('Link copiato negli appunti!');
        }

        // Mobile helpers
        function toggleMobileMenu() {
            document.getElementById('mobileMenuOverlay').classList.toggle('show');
        }
        function closeMobileMenu(e) {
            if (!e || e.target === e.currentTarget) {
                document.getElementById('mobileMenuOverlay').classList.remove('show');
            }
        }
        function toggleMobileThumbs() {
            const overlay = document.getElementById('mobileThumbsOverlay');
            overlay.classList.toggle('show');
            if (overlay.classList.contains('show')) {
                renderMobileThumbnails();
            }
        }
        function closeMobileThumbs(e) {
            if (e.target === e.currentTarget) {
                document.getElementById('mobileThumbsOverlay').classList.remove('show');
            }
        }
        function renderMobileThumbnails() {
            const panel = document.getElementById('mobileThumbsPanel');
            panel.innerHTML = '';
            presentation.slides.forEach((slide, index) => {
                const thumb = document.createElement('div');
                thumb.className = 'slide-thumb' + (index === presentation.currentSlide ? ' active' : '');
                thumb.innerHTML = `
                    <div class="slide-thumb-number">${index + 1}</div>
                    <div class="ppt-mobile-thumb-actions">
                        <button onclick="event.stopPropagation(); duplicateSlideAt(${index}); renderMobileThumbnails();" title="Duplica"><i class="fas fa-copy"></i></button>
                        <button onclick="event.stopPropagation(); deleteSlideAt(${index}); renderMobileThumbnails();" title="Elimina"><i class="fas fa-trash"></i></button>
                    </div>`;
                thumb.onclick = () => {
                    presentation.currentSlide = index;
                    renderThumbnails();
                    renderCurrentSlide();
                    updateSlideCounter();
                    renderMobileThumbnails();
                };
                panel.appendChild(thumb);
            });
        }

        function duplicateCurrentSlide() {
            duplicateSlideAt(presentation.currentSlide);
        }

        function duplicateSlideAt(index) {
            saveState();
            const copy = JSON.parse(JSON.stringify(presentation.slides[index]));
            copy.id = Date.now();
            copy.elements.forEach(el => el.id = Date.now() + Math.random() * 1000);
            presentation.slides.splice(index + 1, 0, copy);
            presentation.currentSlide = index + 1;
            renderThumbnails();
            renderCurrentSlide();
            updateSlideCounter();
        }

        function deleteSlideAt(index) {
            saveState();
            if (presentation.slides.length > 1) {
                presentation.slides.splice(index, 1);
                if (presentation.currentSlide >= presentation.slides.length) {
                    presentation.currentSlide = presentation.slides.length - 1;
                }
                renderThumbnails();
                renderCurrentSlide();
                updateSlideCounter();
            } else {
                showToast('Devi avere almeno una diapositiva!');
            }
        }

        // Touch drag support for mobile
        function addTouchDrag(div, elem) {
            let touchStartX, touchStartY, elemStartX, elemStartY;
            div.addEventListener('touchstart', function(e) {
                if (div.classList.contains('text-element') && document.activeElement === div) return;
                const touch = e.touches[0];
                const canvas = document.getElementById('slideCanvas');
                const canvasRect = canvas.getBoundingClientRect();
                const scaleX = 960 / canvasRect.width;
                const scaleY = 580 / canvasRect.height;
                touchStartX = touch.clientX;
                touchStartY = touch.clientY;
                elemStartX = elem.x;
                elemStartY = elem.y;
                selectElement(div);
                if (e.cancelable) e.preventDefault();
            }, { passive: false });
            div.addEventListener('touchmove', function(e) {
                if (!touchStartX) return;
                const touch = e.touches[0];
                const canvas = document.getElementById('slideCanvas');
                const canvasRect = canvas.getBoundingClientRect();
                const scaleX = 960 / canvasRect.width;
                const scaleY = 580 / canvasRect.height;
                const dx = (touch.clientX - touchStartX) * scaleX;
                const dy = (touch.clientY - touchStartY) * scaleY;
                elem.x = elemStartX + dx;
                elem.y = elemStartY + dy;
                div.style.left = elem.x + 'px';
                div.style.top = elem.y + 'px';
                if (e.cancelable) e.preventDefault();
            }, { passive: false });
            div.addEventListener('touchend', function() {
                touchStartX = null;
                touchStartY = null;
            });
        }

        // Resize handles (mouse + touch)
        function addResizeHandles(div, elem) {
            const positions = ['se', 'sw', 'ne', 'nw'];
            positions.forEach(pos => {
                const handle = document.createElement('div');
                handle.className = `resize-handle resize-handle-${pos}`;
                handle.contentEditable = 'false';

                // Mouse resize
                handle.addEventListener('mousedown', function(e) {
                    e.stopPropagation();
                    e.preventDefault();
                    const canvas = document.getElementById('slideCanvas');
                    const canvasRect = canvas.getBoundingClientRect();
                    const scaleX = 960 / canvasRect.width;
                    const scaleY = 580 / canvasRect.height;
                    const startX = e.clientX;
                    const startY = e.clientY;
                    const startW = elem.width;
                    const startH = elem.height;
                    const startElemX = elem.x;
                    const startElemY = elem.y;

                    function onMove(e) {
                        const dx = (e.clientX - startX) * scaleX;
                        const dy = (e.clientY - startY) * scaleY;
                        applyResize(pos, dx, dy, startW, startH, startElemX, startElemY, elem, div);
                    }
                    function onUp() {
                        document.removeEventListener('mousemove', onMove);
                        document.removeEventListener('mouseup', onUp);
                    }
                    document.addEventListener('mousemove', onMove);
                    document.addEventListener('mouseup', onUp);
                });

                // Touch resize
                handle.addEventListener('touchstart', function(e) {
                    e.stopPropagation();
                    if (e.cancelable) e.preventDefault();
                    const touch = e.touches[0];
                    const canvas = document.getElementById('slideCanvas');
                    const canvasRect = canvas.getBoundingClientRect();
                    const scaleX = 960 / canvasRect.width;
                    const scaleY = 580 / canvasRect.height;
                    const startX = touch.clientX;
                    const startY = touch.clientY;
                    const startW = elem.width;
                    const startH = elem.height;
                    const startElemX = elem.x;
                    const startElemY = elem.y;

                    function onMove(e) {
                        const t = e.touches[0];
                        const dx = (t.clientX - startX) * scaleX;
                        const dy = (t.clientY - startY) * scaleY;
                        applyResize(pos, dx, dy, startW, startH, startElemX, startElemY, elem, div);
                        if (e.cancelable) e.preventDefault();
                    }
                    function onUp() {
                        document.removeEventListener('touchmove', onMove);
                        document.removeEventListener('touchend', onUp);
                    }
                    document.addEventListener('touchmove', onMove, { passive: false });
                    document.addEventListener('touchend', onUp);
                }, { passive: false });

                div.appendChild(handle);
            });
        }

        function applyResize(pos, dx, dy, startW, startH, startX, startY, elem, div) {
            let newW = startW, newH = startH, newX = startX, newY = startY;
            if (pos === 'se') {
                newW = Math.max(40, startW + dx);
                newH = Math.max(30, startH + dy);
            } else if (pos === 'sw') {
                newW = Math.max(40, startW - dx);
                newH = Math.max(30, startH + dy);
                newX = startX + (startW - newW);
            } else if (pos === 'ne') {
                newW = Math.max(40, startW + dx);
                newH = Math.max(30, startH - dy);
                newY = startY + (startH - newH);
            } else if (pos === 'nw') {
                newW = Math.max(40, startW - dx);
                newH = Math.max(30, startH - dy);
                newX = startX + (startW - newW);
                newY = startY + (startH - newH);
            }
            elem.width = newW;
            elem.height = newH;
            elem.x = newX;
            elem.y = newY;
            div.style.width = newW + 'px';
            div.style.height = newH + 'px';
            div.style.left = newX + 'px';
            div.style.top = newY + 'px';
        }

        // Aggiorna titolo documento
        document.getElementById('docTitle').addEventListener('input', (e) => {
            presentation.name = e.target.value;
        });

        // Deseleziona elemento cliccando sul canvas
        document.getElementById('slideCanvas').addEventListener('click', (e) => {
            if (e.target.id === 'slideCanvas') {
                if (selectedElement) {
                    selectedElement.classList.remove('selected');
                    selectedElement = null;
                }
            }
        });

        // Tasti rapidi
        document.addEventListener('keydown', (e) => {
            // Ctrl+S per salvare
            if (e.ctrlKey && e.key === 's') {
                e.preventDefault();
                saveToServer();
            }
            // Canc per eliminare elemento
            if (e.key === 'Delete' && selectedElement) {
                saveState();
                const id = selectedElement.dataset.id;
                const slide = presentation.slides[presentation.currentSlide];
                const index = slide.elements.findIndex(e => e.id == id);
                if (index > -1) {
                    slide.elements.splice(index, 1);
                    renderCurrentSlide();
                }
            }
            // Ctrl+Z per annullare
            if (e.ctrlKey && e.key === 'z') {
                e.preventDefault();
                undo();
            }
            // Ctrl+Y per ripristinare
            if (e.ctrlKey && e.key === 'y') {
                e.preventDefault();
                redo();
            }
            // Ctrl+C per copiare
            if (e.ctrlKey && e.key === 'c' && selectedElement) {
                e.preventDefault();
                const id = selectedElement.dataset.id;
                const slide = presentation.slides[presentation.currentSlide];
                const element = slide.elements.find(e => e.id == id);
                window.copiedElement = JSON.parse(JSON.stringify(element));
                console.log('Elemento copiato');
            }
            // Ctrl+V per incollare
            if (e.ctrlKey && e.key === 'v' && window.copiedElement) {
                e.preventDefault();
                const newElement = JSON.parse(JSON.stringify(window.copiedElement));
                newElement.id = Date.now();
                newElement.x += 20;
                newElement.y += 20;
                presentation.slides[presentation.currentSlide].elements.push(newElement);
                renderCurrentSlide();
                console.log('Elemento incollato');
            }
        });

        // Salvataggio automatico
        setInterval(() => {
            try {
                localStorage.setItem('powerpoint_autosave', JSON.stringify(presentation));
            } catch (e) {
                console.log('Autosave non disponibile');
            }
        }, 30000); // Ogni 30 secondi

        // Carica autosave all'avvio
        window.addEventListener('load', () => {
            try {
                const saved = localStorage.getItem('powerpoint_autosave');
                if (saved && confirm('Trovato salvataggio automatico. Vuoi ripristinarlo?')) {
                    presentation = JSON.parse(saved);
                    document.getElementById('docTitle').value = presentation.name;
                    renderThumbnails();
                    renderCurrentSlide();
                    updateSlideCounter();
                }
            } catch (e) {
                console.log('Nessun autosave disponibile');
            }
        });

        // Inizializza
        init();

        // File Menu Functions
        function toggleFileMenu() {
            const overlay = document.getElementById('fileMenuOverlay');
            overlay.classList.toggle('show');
            if (overlay.classList.contains('show')) {
                showFileSection('info');
            }
        }

        function closeFileMenu() {
            document.getElementById('fileMenuOverlay').classList.remove('show');
        }

        function showFileSection(section) {
            // Nascondi tutte le sezioni
            document.querySelectorAll('.file-section').forEach(s => s.classList.add('hidden'));
            
            // Mostra la sezione selezionata
            const sectionElement = document.getElementById('section-' + section);
            if (sectionElement) {
                sectionElement.classList.remove('hidden');
            }
        }

        function renamePresentation() {
            const newName = document.getElementById('renameInput').value;
            if (newName.trim()) {
                presentation.name = newName;
                document.getElementById('docTitle').value = newName;
            }
        }

        function exportAsPDF() {
            alert('Esportazione PDF - Funzionalità in sviluppo.\nIl file verrà scaricato come JSON.');
            downloadPresentation();
        }

        function exportAsODP() {
            alert('Esportazione ODP - Funzionalità in sviluppo.\nIl file verrà scaricato come JSON.');
            downloadPresentation();
        }

        function exportAsImage() {
            alert('Esportazione come immagine - Funzionalità in sviluppo.\nIl file verrà scaricato come JSON.');
            downloadPresentation();
        }

        // ===== HOME RIBBON FUNCTIONS =====
        function cutElement() {
            if (!selectedElement) { showToast('Seleziona un elemento'); return; }
            copyElement();
            const id = selectedElement.dataset.id;
            const slide = presentation.slides[presentation.currentSlide];
            const index = slide.elements.findIndex(e => e.id == id);
            if (index > -1) { saveState(); slide.elements.splice(index, 1); renderCurrentSlide(); showToast('Elemento tagliato'); }
        }

        function copyElement() {
            if (!selectedElement) { showToast('Seleziona un elemento'); return; }
            const id = selectedElement.dataset.id;
            const slide = presentation.slides[presentation.currentSlide];
            const element = slide.elements.find(e => e.id == id);
            if (element) { window.copiedElement = JSON.parse(JSON.stringify(element)); showToast('Elemento copiato'); }
        }

        function pasteElement() {
            if (!window.copiedElement) { showToast('Niente da incollare'); return; }
            saveState();
            const el = JSON.parse(JSON.stringify(window.copiedElement));
            el.id = Date.now();
            el.x += 20; el.y += 20;
            presentation.slides[presentation.currentSlide].elements.push(el);
            renderCurrentSlide();
            showToast('Elemento incollato');
        }

        function highlightText() {
            if (!selectedElement || !selectedElement.classList.contains('text-element')) { showToast('Seleziona un campo di testo'); return; }
            const id = selectedElement.dataset.id;
            const slide = presentation.slides[presentation.currentSlide];
            const elem = slide.elements.find(e => e.id == id);
            if (elem) {
                elem.bgColor = elem.bgColor === 'yellow' ? 'transparent' : 'yellow';
                renderCurrentSlide();
            }
        }

        function alignText(align) {
            if (!selectedElement || !selectedElement.classList.contains('text-element')) { showToast('Seleziona un campo di testo'); return; }
            const id = selectedElement.dataset.id;
            const slide = presentation.slides[presentation.currentSlide];
            const elem = slide.elements.find(e => e.id == id);
            if (elem) { elem.textAlign = align; selectedElement.style.textAlign = align; }
        }

        function toggleBullets() {
            if (!selectedElement || !selectedElement.classList.contains('text-element')) { showToast('Seleziona un campo di testo'); return; }
            document.execCommand('insertUnorderedList');
        }

        // ===== INSERT RIBBON FUNCTIONS =====
        function insertTable() {
            saveState();
            const rows = 3, cols = 3;
            let html = '<table style="width:100%;border-collapse:collapse;font-size:14px;">';
            for (let r = 0; r < rows; r++) {
                html += '<tr>';
                for (let c = 0; c < cols; c++) {
                    html += '<td style="border:1px solid #ccc;padding:8px;" contenteditable="false">Cella</td>';
                }
                html += '</tr>';
            }
            html += '</table>';
            const element = { id: Date.now(), type: 'text', x: 100, y: 150, width: 500, height: 200, content: html, fontSize: 14, color: '#000', bgColor: 'transparent', bold: false, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: false };
            presentation.slides[presentation.currentSlide].elements.push(element);
            renderCurrentSlide();
            showToast('Tabella inserita');
        }

        function insertCameo() {
            if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                showToast('Cameo: funzionalità webcam non ancora supportata nel browser');
            } else {
                showToast('Webcam non disponibile');
            }
        }

        function insertVideo() {
            const url = prompt('Inserisci URL del video (YouTube, Vimeo, ecc.):');
            if (!url) return;
            saveState();
            let embedUrl = url;
            const ytMatch = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]+)/);
            if (ytMatch) embedUrl = 'https://www.youtube.com/embed/' + ytMatch[1];
            const element = { id: Date.now(), type: 'text', x: 100, y: 100, width: 480, height: 270, content: `<iframe src="${embedUrl}" style="width:100%;height:100%;border:none;" allowfullscreen></iframe>`, fontSize: 14, color: '#000', bgColor: 'transparent', bold: false, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: false };
            presentation.slides[presentation.currentSlide].elements.push(element);
            renderCurrentSlide();
            showToast('Video inserito');
        }

        function insertAudio() {
            const input = document.createElement('input');
            input.type = 'file'; input.accept = 'audio/*';
            input.onchange = (e) => {
                const file = e.target.files[0]; if (!file) return;
                const reader = new FileReader();
                reader.onload = (ev) => {
                    saveState();
                    const element = { id: Date.now(), type: 'text', x: 200, y: 300, width: 300, height: 60, content: `<audio controls style="width:100%;"><source src="${ev.target.result}"></audio>`, fontSize: 14, color: '#000', bgColor: '#f3f2f1', bold: false, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: false };
                    presentation.slides[presentation.currentSlide].elements.push(element);
                    renderCurrentSlide();
                    showToast('Audio inserito');
                };
                reader.readAsDataURL(file);
            };
            input.click();
        }

        function insertIcon() {
            const icons = ['⭐', '❤️', '✅', '⚡', '🔥', '💡', '🎯', '📌', '🏆', '🚀', '💎', '🔔', '📊', '🎨', '🔧', '📱'];
            const icon = prompt('Scegli un\'icona (copia e incolla):\n\n' + icons.join('  '));
            if (!icon) return;
            saveState();
            const element = { id: Date.now(), type: 'text', x: 400, y: 250, width: 80, height: 80, content: icon, fontSize: 48, color: '#000', bgColor: 'transparent', bold: false, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: false };
            presentation.slides[presentation.currentSlide].elements.push(element);
            renderCurrentSlide();
        }

        function insertSmartArt() {
            saveState();
            const colors = ['#4472c4', '#ed7d31', '#a5a5a5', '#ffc000'];
            let html = '<div style="display:flex;gap:8px;align-items:center;height:100%;">';
            ['Idea', 'Piano', 'Azione', 'Risultato'].forEach((t, i) => {
                html += `<div style="flex:1;background:${colors[i]};color:white;padding:12px;text-align:center;border-radius:4px;font-size:14px;font-weight:bold;">${t}</div>`;
                if (i < 3) html += '<div style="font-size:24px;color:#666;">→</div>';
            });
            html += '</div>';
            const element = { id: Date.now(), type: 'text', x: 60, y: 200, width: 840, height: 80, content: html, fontSize: 14, color: '#000', bgColor: 'transparent', bold: false, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: false };
            presentation.slides[presentation.currentSlide].elements.push(element);
            renderCurrentSlide();
            showToast('SmartArt inserito');
        }

        function insertChart() {
            saveState();
            const data = [65, 80, 45, 90, 55];
            const labels = ['Gen', 'Feb', 'Mar', 'Apr', 'Mag'];
            const maxVal = Math.max(...data);
            let html = '<div style="display:flex;align-items:flex-end;gap:16px;height:100%;padding:10px 20px 30px;">';
            data.forEach((v, i) => {
                const h = (v / maxVal) * 100;
                html += `<div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;"><div style="width:100%;background:#4472c4;height:${h}%;border-radius:2px 2px 0 0;min-height:4px;"></div><div style="font-size:11px;margin-top:4px;">${labels[i]}</div></div>`;
            });
            html += '</div>';
            const element = { id: Date.now(), type: 'text', x: 150, y: 150, width: 600, height: 300, content: html, fontSize: 14, color: '#000', bgColor: '#fff', bold: false, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: false };
            presentation.slides[presentation.currentSlide].elements.push(element);
            renderCurrentSlide();
            showToast('Grafico inserito');
        }

        function insertLink() {
            if (!selectedElement || !selectedElement.classList.contains('text-element')) {
                showToast('Seleziona un campo di testo prima');
                return;
            }
            const url = prompt('Inserisci URL:');
            if (url) {
                const text = prompt('Testo del collegamento:', url);
                document.execCommand('insertHTML', false, `<a href="${url}" target="_blank" style="color:#4472c4;text-decoration:underline;">${text || url}</a>`);
            }
        }

        function insertFooter() {
            saveState();
            const slide = presentation.slides[presentation.currentSlide];
            const element = { id: Date.now(), type: 'text', x: 60, y: 530, width: 840, height: 30, content: `Diapositiva ${presentation.currentSlide + 1} | ${new Date().toLocaleDateString('it-IT')}`, fontSize: 12, color: '#888', bgColor: 'transparent', bold: false, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: false };
            slide.elements.push(element);
            renderCurrentSlide();
            showToast('Pie di pagina inserito');
        }

        function insertSymbol() {
            const symbols = '© ® ™ § ¶ † ‡ ° ± × ÷ ≠ ≈ ≤ ≥ ∞ ∑ √ π Ω α β γ δ ε ← → ↑ ↓ ★ ♠ ♣ ♥ ♦';
            const sym = prompt('Scegli un simbolo (copia e incolla):\n\n' + symbols);
            if (!sym) return;
            if (selectedElement && selectedElement.classList.contains('text-element') && document.activeElement === selectedElement) {
                document.execCommand('insertText', false, sym);
            } else {
                saveState();
                const element = { id: Date.now(), type: 'text', x: 400, y: 250, width: 60, height: 60, content: sym, fontSize: 36, color: '#000', bgColor: 'transparent', bold: false, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: false };
                presentation.slides[presentation.currentSlide].elements.push(element);
                renderCurrentSlide();
            }
        }

        // ===== DRAW RIBBON FUNCTIONS =====
        let currentDrawTool = null;
        let drawColor = '#000000';
        let drawWidth = 4;
        let isDrawing = false;
        let drawPaths = {};

        function setDrawTool(tool) {
            currentDrawTool = tool;
            const canvas = document.getElementById('slideCanvas');
            if (tool) {
                canvas.style.cursor = 'crosshair';
                showToast('Strumento disegno: ' + (tool === 'pencil' ? 'Matita' : tool === 'marker' ? 'Pennarello' : 'Penna'));
            } else {
                canvas.style.cursor = 'default';
                showToast('Modalita selezione');
            }
        }

        function clearDrawing() {
            const slideId = presentation.slides[presentation.currentSlide].id;
            drawPaths[slideId] = [];
            const drawCanvas = document.getElementById('drawCanvas');
            if (drawCanvas) { drawCanvas.getContext('2d').clearRect(0, 0, drawCanvas.width, drawCanvas.height); }
            showToast('Disegno cancellato');
        }

        // ===== LAYOUT/DESIGN FUNCTIONS =====
        function applyTheme(bg) {
            saveState();
            const slide = presentation.slides[presentation.currentSlide];
            slide.background = bg;
            renderCurrentSlide();
            showToast('Tema applicato');
        }

        function changeSlideLayout() {
            const layouts = ['Titolo', 'Titolo e contenuto', 'Vuoto', 'Due contenuti', 'Solo titolo'];
            const choice = prompt('Scegli layout:\n' + layouts.map((l, i) => (i + 1) + '. ' + l).join('\n'));
            if (!choice) return;
            saveState();
            const slide = presentation.slides[presentation.currentSlide];
            slide.elements = [];
            const idx = parseInt(choice) - 1;
            if (idx === 0) {
                slide.elements.push({ id: Date.now(), type: 'text', x: 60, y: 180, width: 840, height: 120, content: 'Titolo', fontSize: 44, color: '#000', bgColor: 'transparent', bold: true, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: true });
                slide.elements.push({ id: Date.now()+1, type: 'text', x: 60, y: 320, width: 840, height: 60, content: 'Sottotitolo', fontSize: 20, color: '#666', bgColor: 'transparent', bold: false, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: true });
            } else if (idx === 1) {
                slide.elements.push({ id: Date.now(), type: 'text', x: 60, y: 20, width: 840, height: 60, content: 'Titolo', fontSize: 32, color: '#000', bgColor: 'transparent', bold: true, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: true });
                slide.elements.push({ id: Date.now()+1, type: 'text', x: 60, y: 100, width: 840, height: 400, content: 'Contenuto', fontSize: 18, color: '#000', bgColor: 'transparent', bold: false, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: true });
            } else if (idx === 3) {
                slide.elements.push({ id: Date.now(), type: 'text', x: 60, y: 20, width: 840, height: 60, content: 'Titolo', fontSize: 32, color: '#000', bgColor: 'transparent', bold: true, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: true });
                slide.elements.push({ id: Date.now()+1, type: 'text', x: 60, y: 100, width: 400, height: 400, content: 'Contenuto sinistro', fontSize: 16, color: '#000', bgColor: 'transparent', bold: false, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: true });
                slide.elements.push({ id: Date.now()+2, type: 'text', x: 500, y: 100, width: 400, height: 400, content: 'Contenuto destro', fontSize: 16, color: '#000', bgColor: 'transparent', bold: false, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: true });
            } else if (idx === 4) {
                slide.elements.push({ id: Date.now(), type: 'text', x: 60, y: 20, width: 840, height: 80, content: 'Solo Titolo', fontSize: 36, color: '#000', bgColor: 'transparent', bold: true, italic: false, underline: false, fontFamily: 'Calibri', isPlaceholder: true });
            }
            renderThumbnails();
            renderCurrentSlide();
            showToast('Layout applicato');
        }

        function formatSlide() {
            const color = prompt('Colore testo diapositiva (es. #333, red, blue):');
            if (!color) return;
            saveState();
            presentation.slides[presentation.currentSlide].elements.forEach(el => { if (el.type === 'text') el.color = color; });
            renderCurrentSlide();
        }

        function changeBackground() {
            const color = prompt('Colore sfondo (es. #ffffff, #f0f0f0, lightblue):');
            if (!color) return;
            saveState();
            presentation.slides[presentation.currentSlide].background = color;
            renderCurrentSlide();
            showToast('Sfondo modificato');
        }

        // ===== TRANSITION FUNCTIONS =====
        function setTransition(type) {
            const slide = presentation.slides[presentation.currentSlide];
            slide.transition = type;
            slide.transitionDuration = parseFloat(document.getElementById('transitionDuration').value) || 0.5;
            showToast('Transizione: ' + (type === 'none' ? 'Nessuna' : type));
        }

        function setTransitionDirection(dir) {
            presentation.slides[presentation.currentSlide].transitionDirection = dir;
        }

        function setTransitionDuration(val) {
            presentation.slides[presentation.currentSlide].transitionDuration = parseFloat(val);
        }

        function applyTransitionToAll() {
            const current = presentation.slides[presentation.currentSlide];
            presentation.slides.forEach(s => {
                s.transition = current.transition;
                s.transitionDuration = current.transitionDuration;
                s.transitionDirection = current.transitionDirection;
            });
            showToast('Transizione applicata a tutte le diapositive');
        }

        function previewTransition() {
            const slide = presentation.slides[presentation.currentSlide];
            const type = slide.transition || 'none';
            if (type === 'none') { showToast('Nessuna transizione impostata'); return; }
            const canvas = document.getElementById('slideCanvas');
            const dur = (slide.transitionDuration || 0.5) * 1000;
            const animations = {
                'fade': [{ opacity: 0 }, { opacity: 1 }],
                'morph': [{ transform: 'scale(0.8)', opacity: 0 }, { transform: 'scale(1)', opacity: 1 }],
                'cut': [{ clipPath: 'inset(0 100% 0 0)' }, { clipPath: 'inset(0 0 0 0)' }],
                'push': [{ transform: 'translateX(-100%)' }, { transform: 'translateX(0)' }],
                'wipe': [{ clipPath: 'inset(0 0 100% 0)' }, { clipPath: 'inset(0 0 0 0)' }]
            };
            canvas.animate(animations[type] || animations['fade'], { duration: dur, easing: 'ease-in-out' });
            showToast('Anteprima: ' + type);
        }

        // ===== ANIMATION FUNCTIONS =====
        function setAnimation(type) {
            if (!selectedElement) { showToast('Seleziona un elemento'); return; }
            const id = selectedElement.dataset.id;
            const slide = presentation.slides[presentation.currentSlide];
            const elem = slide.elements.find(e => e.id == id);
            if (elem) {
                elem.animation = type;
                elem.animDuration = parseFloat(document.getElementById('animDuration').value) || 0.5;
                elem.animDelay = parseFloat(document.getElementById('animDelay').value) || 0;
                showToast('Animazione: ' + (type === 'none' ? 'Nessuna' : type));
            }
        }

        function setAnimationOption(val) { if (selectedElement) { const id = selectedElement.dataset.id; const el = presentation.slides[presentation.currentSlide].elements.find(e=>e.id==id); if(el) el.animDirection = val; } }
        function setAnimationStart(val) { if (selectedElement) { const id = selectedElement.dataset.id; const el = presentation.slides[presentation.currentSlide].elements.find(e=>e.id==id); if(el) el.animStart = val; } }
        function setAnimationDuration(val) { if (selectedElement) { const id = selectedElement.dataset.id; const el = presentation.slides[presentation.currentSlide].elements.find(e=>e.id==id); if(el) el.animDuration = parseFloat(val); } }
        function setAnimationDelay(val) { if (selectedElement) { const id = selectedElement.dataset.id; const el = presentation.slides[presentation.currentSlide].elements.find(e=>e.id==id); if(el) el.animDelay = parseFloat(val); } }

        function previewAnimation() {
            if (!selectedElement) { showToast('Seleziona un elemento'); return; }
            const id = selectedElement.dataset.id;
            const elem = presentation.slides[presentation.currentSlide].elements.find(e => e.id == id);
            if (!elem || !elem.animation || elem.animation === 'none') { showToast('Nessuna animazione impostata'); return; }
            const dur = (elem.animDuration || 0.5) * 1000;
            const anims = {
                'appear': [{ opacity: 0, transform: 'scale(0)' }, { opacity: 1, transform: 'scale(1)' }],
                'fadeIn': [{ opacity: 0 }, { opacity: 1 }],
                'flyIn': [{ transform: 'translateX(-200px)', opacity: 0 }, { transform: 'translateX(0)', opacity: 1 }]
            };
            selectedElement.animate(anims[elem.animation] || anims['fadeIn'], { duration: dur, easing: 'ease-out' });
        }

        function moveAnimationUp() { showToast('Ordine animazione spostato'); }
        function moveAnimationDown() { showToast('Ordine animazione spostato'); }
        function toggleAnimationPane() { showToast('Riquadro animazione: usa i controlli nel ribbon'); }

        // ===== SLIDESHOW FUNCTIONS =====
        function startSlideshowFrom(startIndex) {
            let currentIdx = startIndex;
            const overlay = document.createElement('div');
            overlay.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:#000;z-index:99999;display:flex;align-items:center;justify-content:center;cursor:none;';
            const slideContainer = document.createElement('div');
            slideContainer.style.cssText = 'width:100vw;height:100vh;position:relative;overflow:hidden;';
            overlay.appendChild(slideContainer);
            document.body.appendChild(overlay);

            function renderSlide(idx) {
                const slide = presentation.slides[idx];
                slideContainer.style.background = slide.background || '#fff';
                slideContainer.innerHTML = '';
                const scaleX = window.innerWidth / 960;
                const scaleY = window.innerHeight / 580;
                const scale = Math.min(scaleX, scaleY);
                const offsetX = (window.innerWidth - 960 * scale) / 2;
                const offsetY = (window.innerHeight - 580 * scale) / 2;
                slide.elements.forEach(elem => {
                    const div = document.createElement('div');
                    div.style.cssText = `position:absolute;left:${offsetX + elem.x * scale}px;top:${offsetY + elem.y * scale}px;width:${elem.width * scale}px;height:${elem.height * scale}px;font-size:${elem.fontSize * scale}px;color:${elem.color};background:${elem.bgColor};font-weight:${elem.bold?'bold':'normal'};font-style:${elem.italic?'italic':'normal'};text-decoration:${elem.underline?'underline':'none'};font-family:${elem.fontFamily||'Calibri'};padding:${16*scale}px;overflow:hidden;`;
                    if (elem.type === 'image') { div.innerHTML = `<img src="${elem.src}" style="width:100%;height:100%;object-fit:contain;">`; }
                    else if (elem.type === 'shape') { div.style.backgroundColor = elem.bgColor; if (elem.shape==='circle') div.style.borderRadius='50%'; }
                    else { div.innerHTML = elem.content; }
                    slideContainer.appendChild(div);
                });
                const counter = document.createElement('div');
                counter.style.cssText = 'position:absolute;bottom:10px;right:20px;color:rgba(255,255,255,0.5);font-size:14px;';
                counter.textContent = (idx + 1) + ' / ' + presentation.slides.length;
                slideContainer.appendChild(counter);
            }

            renderSlide(currentIdx);

            function next() { if (currentIdx < presentation.slides.length - 1) { currentIdx++; renderSlide(currentIdx); } else { overlay.remove(); } }
            function prev() { if (currentIdx > 0) { currentIdx--; renderSlide(currentIdx); } }

            overlay.addEventListener('click', next);
            document.addEventListener('keydown', function handler(e) {
                if (e.key === 'Escape') { overlay.remove(); document.removeEventListener('keydown', handler); }
                else if (e.key === 'ArrowRight' || e.key === ' ') next();
                else if (e.key === 'ArrowLeft') prev();
            });
        }

        function startPresenterView() {
            startSlideshowFrom(0);
            showToast('Usa frecce per navigare, ESC per uscire');
        }

        // ===== REVIEW FUNCTIONS =====
        function checkSlide() {
            const slide = presentation.slides[presentation.currentSlide];
            const count = slide.elements.length;
            const textCount = slide.elements.filter(e => e.type === 'text').length;
            const imgCount = slide.elements.filter(e => e.type === 'image').length;
            showToast(`Diapositiva ${presentation.currentSlide + 1}: ${count} elementi (${textCount} testi, ${imgCount} immagini)`);
        }

        function checkAccessibility() {
            const slide = presentation.slides[presentation.currentSlide];
            let issues = [];
            slide.elements.forEach(el => {
                if (el.type === 'text' && el.fontSize < 14) issues.push('Testo troppo piccolo (< 14px)');
                if (el.type === 'image' && !el.alt) issues.push('Immagine senza testo alternativo');
            });
            if (issues.length === 0) showToast('Nessun problema di accessibilita trovato!');
            else alert('Problemi di accessibilita:\n\n' + issues.join('\n'));
        }

        function deleteAllComments() {
            if (comments.length === 0) { showToast('Nessun commento'); return; }
            if (confirm('Eliminare tutti i commenti?')) {
                comments = [];
                localStorage.setItem('ppt_comments', '[]');
                showToast('Tutti i commenti eliminati');
                if (document.getElementById('commentsPanel').classList.contains('open')) renderComments();
            }
        }

        function navigateComment(dir) {
            if (comments.length === 0) { showToast('Nessun commento'); return; }
            if (!document.getElementById('commentsPanel').classList.contains('open')) toggleCommentsPanel();
        }

        function searchInSlides() {
            const term = prompt('Cerca nelle diapositive:');
            if (!term) return;
            const results = [];
            presentation.slides.forEach((slide, idx) => {
                slide.elements.forEach(el => {
                    if (el.type === 'text' && el.content.toLowerCase().includes(term.toLowerCase())) {
                        results.push('Diapositiva ' + (idx + 1));
                    }
                });
            });
            if (results.length === 0) showToast('Nessun risultato per "' + term + '"');
            else alert('Trovato in:\n' + [...new Set(results)].join('\n'));
        }

        // ===== VIEW FUNCTIONS =====
        let notesVisible = false;
        function toggleNotes() {
            notesVisible = !notesVisible;
            let notesPanel = document.getElementById('notesPanel');
            if (!notesPanel) {
                notesPanel = document.createElement('div');
                notesPanel.id = 'notesPanel';
                notesPanel.style.cssText = 'background:#fff;border-top:1px solid #edebe9;padding:8px 16px;min-height:80px;max-height:150px;overflow-y:auto;';
                notesPanel.innerHTML = '<div style="font-size:11px;color:#666;margin-bottom:4px;">Note della diapositiva</div><div contenteditable="true" style="font-size:13px;outline:none;min-height:40px;" id="slideNotes" oninput="presentation.slides[presentation.currentSlide].notes=this.innerHTML"></div>';
                document.querySelector('.workspace').appendChild(notesPanel);
            }
            notesPanel.style.display = notesVisible ? 'block' : 'none';
            if (notesVisible) {
                const n = document.getElementById('slideNotes');
                if (n) n.innerHTML = presentation.slides[presentation.currentSlide].notes || '';
            }
            showToast(notesVisible ? 'Note visibili' : 'Note nascoste');
        }

        function toggleRuler() {
            let ruler = document.getElementById('canvasRuler');
            if (ruler) { ruler.remove(); showToast('Righello nascosto'); return; }
            ruler = document.createElement('div');
            ruler.id = 'canvasRuler';
            ruler.style.cssText = 'height:20px;background:#f3f2f1;border-bottom:1px solid #ccc;display:flex;align-items:flex-end;padding:0 4px;font-size:9px;color:#666;';
            for (let i = 0; i <= 24; i++) { const m = document.createElement('span'); m.style.cssText = 'flex:1;border-left:1px solid #ccc;padding-left:2px;'; m.textContent = i; ruler.appendChild(m); }
            const area = document.querySelector('.canvas-area');
            area.insertBefore(ruler, area.firstChild);
            showToast('Righello visibile');
        }

        function toggleSlideSorter() {
            const panel = document.querySelector('.thumbnails-panel');
            if (panel) {
                panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
                showToast(panel.style.display === 'none' ? 'Pannello miniature nascosto' : 'Pannello miniature visibile');
            }
        }

        function setViewNormal() {
            const panel = document.querySelector('.thumbnails-panel');
            if (panel) panel.style.display = '';
            const designer = document.querySelector('.designer-panel');
            if (designer) designer.style.display = '';
            showToast('Vista normale');
        }

        function zoomDialog() {
            const val = prompt('Livello di zoom (10-400):', zoomLevel);
            if (val) { zoomLevel = parseInt(val); updateZoom(zoomLevel); }
        }

        function fitToWindow() {
            zoomLevel = 100;
            updateZoom(100);
            const slider = document.querySelector('.zoom-control input[type="range"]');
            if (slider) slider.value = 100;
            showToast('Adattato alla finestra');
        }

        // ===== HELP FUNCTIONS =====
        function showHelp() {
            alert('Guida di Office Suite - PowerPoint Clone\n\n' +
                '- Clic: seleziona un elemento\n' +
                '- Doppio clic: modifica testo\n' +
                '- Trascina: sposta elementi\n' +
                '- Maniglie angolari: ridimensiona\n' +
                '- Ctrl+S: salva\n- Ctrl+Z: annulla\n- Ctrl+Y: ripristina\n' +
                '- Ctrl+C/V: copia/incolla\n- Canc: elimina elemento\n' +
                '- F5: presentazione dall\'inizio');
        }

        function showFeedback() {
            const fb = prompt('Scrivi il tuo feedback:');
            if (fb) showToast('Grazie per il feedback!');
        }

        function showKeyboardShortcuts() {
            alert('Scelte rapide da tastiera:\n\n' +
                'Ctrl+S  - Salva sul server\n' +
                'Ctrl+Z  - Annulla\n' +
                'Ctrl+Y  - Ripristina\n' +
                'Ctrl+C  - Copia elemento\n' +
                'Ctrl+V  - Incolla elemento\n' +
                'Canc    - Elimina elemento\n' +
                'Esc     - Esci da presentazione\n' +
                'Frecce  - Naviga nella presentazione');
        }

        function showWhatsNew() {
            alert('Novita di PowerPoint Clone v2.0:\n\n' +
                '- Ridimensionamento touch su mobile\n' +
                '- Sistema commenti\n' +
                '- Transizioni e animazioni\n' +
                '- Strumenti di disegno\n' +
                '- Gestione diapositive mobile\n' +
                '- Temi e layout\n' +
                '- Esportazione multipla\n' +
                '- App Launcher integrato');
        }

        // ===== SETTINGS =====
        function showSettings() {
            alert('Impostazioni:\n\n' +
                'Autosalvataggio: attivo\n' +
                'Lingua: Italiano\n' +
                'Tema: Chiaro\n\n' +
                'Le impostazioni avanzate saranno disponibili in una futura versione.');
        }

        // ===== SHARE HELPERS =====
        function copyShareLinkDirect() {
            const filename = presentation.name.replace(/[^a-zA-Z0-9_-]/g, '_') + '.json';
            const link = window.location.origin + '/saved_presentations/' + filename;
            navigator.clipboard.writeText(link).then(() => showToast('Link copiato!')).catch(() => showToast('Salva prima la presentazione'));
        }

        function embedPresentation() {
            const filename = presentation.name.replace(/[^a-zA-Z0-9_-]/g, '_') + '.json';
            const url = window.location.href;
            const code = '<iframe src="' + url + '" width="800" height="500" frameborder="0"></iframe>';
            prompt('Copia il codice di incorporamento:', code);
        }

    </script>
    <script src="../shared/app-launcher.js"></script>
    <script>OfficeLauncher.init();</script>
</body>
</html>
