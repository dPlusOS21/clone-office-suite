            </div>

            <div class="design-template" onclick="applyDesign('gradient3')">
                <div class="design-preview" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    Fare clic per inserire il titolo
                </div>
                <div class="design-caption">Design professionale</div>
            </div>

            <div class="design-template" onclick="applyDesign('gradient4')">
                <div class="design-preview" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                    Fare clic per inserire il titolo
                </div>
                <div class="design-caption">Design fresco</div>
            </div>
