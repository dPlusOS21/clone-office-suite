            </div>
        </div>
    </div>

    <!-- Workspace -->
    <div class="workspace">
        <!-- Thumbnails panel -->
        <div class="thumbnails-panel" id="thumbnailsPanel"></div>

        <!-- Canvas area -->
        <div class="canvas-area">
            <div class="slide-canvas" id="slideCanvas"></div>
        </div>

        <!-- Designer panel -->
        <div class="designer-panel">
            <div class="designer-header">
                <div class="designer-title">Designer</div>
                <button class="close-btn" onclick="toggleDesigner()">✕</button>
            </div>
            
            <div class="design-template" onclick="applyDesign('gradient1')">
                <div class="design-preview" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    Fare clic per inserire il titolo
                </div>
