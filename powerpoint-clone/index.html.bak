<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Presentation 1</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            background: #fafafa;
        }

        /* Barra superiore */
        .top-bar {
            background: white;
            border-bottom: 1px solid #edebe9;
            display: flex;
            align-items: center;
            padding: 4px 12px;
            gap: 12px;
            height: 48px;
        }

        .app-grid {
            width: 24px;
            height: 24px;
            display: grid;
            grid-template-columns: repeat(3, 6px);
            gap: 2px;
            cursor: pointer;
            padding: 4px;
        }

        .app-grid:hover {
            background: #f3f2f1;
            border-radius: 2px;
        }

        .grid-dot {
            width: 6px;
            height: 6px;
            background: #605e5c;
            border-radius: 50%;
        }

        .app-icon {
            width: 24px;
            height: 24px;
            background: #d24726;
            border-radius: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 12px;
        }

        .doc-title {
            font-size: 13px;
            padding: 6px 8px;
            border: none;
            outline: none;
            border-radius: 2px;
            background: transparent;
        }

        .doc-title:hover {
            background: #f3f2f1;
        }

        .save-status {
            font-size: 11px;
            color: #605e5c;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .top-right {
            margin-left: auto;
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .top-btn {
            padding: 6px 12px;
            border: 1px solid #8a8886;
            background: white;
            border-radius: 2px;
            font-size: 13px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .top-btn:hover {
            background: #f3f2f1;
        }

        .top-btn.primary {
            background: #d24726;
            color: white;
            border: none;
        }

        .top-btn.primary:hover {
            background: #b93b1d;
        }

        .icon-btn {
            background: transparent;
            border: none;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border-radius: 2px;
            font-size: 16px;
        }

        .icon-btn:hover {
            background: #f3f2f1;
        }

        .user-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #0078d4;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            background: #f3f2f1;
            border-radius: 4px;
            width: 300px;
        }

        .search-box input {
            border: none;
            background: transparent;
            outline: none;
            font-size: 13px;
            width: 100%;
        }

        /* Ribbon tabs */
        .ribbon-tabs {
            background: white;
            border-bottom: 1px solid #edebe9;
            display: flex;
            padding: 0 12px;
            gap: 16px;
        }

        .ribbon-tab {
            padding: 8px 12px;
            font-size: 13px;
            cursor: pointer;
            border-bottom: 3px solid transparent;
            color: #323130;
        }

        .ribbon-tab:hover {
            background: #f3f2f1;
        }

        .ribbon-tab.active {
            border-bottom-color: #d24726;
        }

        /* Ribbon content */
        .ribbon-content {
            background: #fafafa;
            padding: 8px 12px;
            display: flex;
            gap: 2px;
            border-bottom: 1px solid #edebe9;
            align-items: flex-start;
            min-height: 92px;
            overflow-x: auto;
        }

        .ribbon-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 0 8px;
            border-right: 1px solid #edebe9;
            min-width: fit-content;
        }

        .ribbon-group:last-child {
            border-right: none;
        }

        .ribbon-group-content {
            display: flex;
            gap: 4px;
            align-items: center;
            flex-wrap: wrap;
        }

        .ribbon-group-label {
            font-size: 11px;
            color: #605e5c;
            text-align: center;
            margin-top: 4px;
        }

        .ribbon-btn {
            background: transparent;
            border: 1px solid transparent;
            padding: 8px;
            cursor: pointer;
            border-radius: 2px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            min-width: 56px;
            font-size: 11px;
            color: #323130;
        }

        .ribbon-btn:hover {
            background: #f3f2f1;
            border-color: #edebe9;
        }

        .ribbon-btn-icon {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .ribbon-btn.small {
            flex-direction: row;
            min-width: auto;
            padding: 4px 8px;
        }

        .ribbon-btn.small .ribbon-btn-icon {
            width: 20px;
            height: 20px;
            font-size: 14px;
        }

        .ribbon-dropdown {
            background: white;
            border: 1px solid #edebe9;
            padding: 4px 8px;
            border-radius: 2px;
            font-size: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .ribbon-dropdown:hover {
            background: #f3f2f1;
        }

        /* App launcher popup */
        .app-launcher {
            position: fixed;
            top: 48px;
            left: 12px;
            background: white;
            border: 1px solid #edebe9;
            box-shadow: 0 4px 16px rgba(0,0,0,0.15);
            border-radius: 8px;
            padding: 24px;
            width: 480px;
            display: none;
            z-index: 2000;
        }

        .app-launcher.show {
            display: block;
        }

        .app-search {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #edebe9;
            border-radius: 4px;
            font-size: 13px;
            margin-bottom: 24px;
        }

        .app-grid-container {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 16px;
            margin-bottom: 32px;
        }

        .app-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            padding: 12px;
            border-radius: 4px;
        }

        .app-item:hover {
            background: #f3f2f1;
        }

        .app-item-icon {
            width: 48px;
            height: 48px;
            font-size: 32px;
        }

        .app-item-label {
            font-size: 12px;
            text-align: center;
        }

        .create-section {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 16px;
            padding-top: 16px;
            border-top: 1px solid #edebe9;
        }

        .create-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            padding: 8px;
            border-radius: 4px;
        }

        .create-item:hover {
            background: #f3f2f1;
        }

        .create-item-preview {
            width: 60px;
            height: 48px;
            border: 1px solid #edebe9;
            border-radius: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .create-item-label {
            font-size: 11px;
            text-align: center;
        }

        /* Workspace */
        .workspace {
            display: flex;
            height: calc(100vh - 210px);
            background: #f3f2f1;
        }

        /* Slide thumbnails */
        .thumbnails-panel {
            width: 180px;
            background: white;
            border-right: 1px solid #edebe9;
            overflow-y: auto;
            padding: 8px;
        }

        .slide-thumb {
            background: white;
            border: 1px solid #edebe9;
            margin-bottom: 12px;
            cursor: pointer;
            position: relative;
            aspect-ratio: 16/9;
            box-shadow: 0 1.6px 3.6px rgba(0,0,0,0.13);
        }

        .slide-thumb:hover {
            border-color: #d24726;
        }

        .slide-thumb.active {
            border: 2px solid #d24726;
            box-shadow: 0 0 0 1px #d24726;
        }

        .slide-thumb-number {
            position: absolute;
            top: 4px;
            left: 4px;
            background: rgba(0,0,0,0.6);
            color: white;
            padding: 2px 6px;
            font-size: 10px;
            border-radius: 2px;
        }

        /* Canvas area */
        .canvas-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 24px;
            overflow: auto;
        }

        .slide-canvas {
            background: white;
            width: 960px;
            height: 580px;
            box-shadow: 0 3.2px 7.2px rgba(0,0,0,0.13);
            position: relative;
            overflow: hidden;
            transition: transform 0.2s;
            top: 20px;
        }

        /* Designer panel */
        .designer-panel {
            width: 320px;
            background: white;
            border-left: 1px solid #edebe9;
            overflow-y: auto;
            padding: 16px;
        }

        .designer-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .designer-title {
            font-size: 16px;
            font-weight: 600;
        }

        .close-btn {
            background: transparent;
            border: none;
            font-size: 16px;
            cursor: pointer;
            padding: 4px;
        }

        .design-template {
            margin-bottom: 16px;
            cursor: pointer;
            border-radius: 4px;
            overflow: hidden;
            box-shadow: 0 1.6px 3.6px rgba(0,0,0,0.13);
        }

        .design-template:hover {
            box-shadow: 0 3.2px 7.2px rgba(0,0,0,0.13);
        }

        .design-preview {
            width: 100%;
            height: 140px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 14px;
        }

        .design-caption {
            padding: 8px;
            font-size: 11px;
            background: white;
            text-align: center;
        }

        /* Slide elements */
        .slide-element {
            position: absolute;
            cursor: move;
            border: 2px solid transparent;
        }

        .slide-element.selected {
            border: 2px solid #d24726;
        }

        /* resize handles now DOM elements */

        .text-element {
            padding: 16px;
            min-width: 200px;
            min-height: 60px;
        }

        .text-element[contenteditable="true"] {
            outline: none;
        }

        .text-placeholder {
            color: #a19f9d;
        }

        .image-element img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .shape-element {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Bottom bar */
        .bottom-bar {
            background: white;
            border-top: 1px solid #edebe9;
            padding: 4px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 11px;
            color: #605e5c;
            height: 32px;
        }

        .bottom-left {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .bottom-right {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .zoom-control {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .zoom-btn {
            background: transparent;
            border: none;
            padding: 4px 8px;
            cursor: pointer;
            font-size: 14px;
        }

        .zoom-btn:hover {
            background: #f3f2f1;
        }

        .zoom-slider {
            width: 100px;
        }

        input[type="color"] {
            width: 32px;
            height: 32px;
            border: 1px solid #edebe9;
            cursor: pointer;
            border-radius: 2px;
        }

        select {
            padding: 4px 8px;
            border: 1px solid #edebe9;
            background: white;
            font-size: 12px;
            border-radius: 2px;
        }

        .hidden {
            display: none !important;
        }

        /* File Menu Overlay */
        .file-menu-overlay {
            position: fixed;
            top: 48px;
            left: 0;
            right: 0;
            bottom: 0;
            background: white;
            z-index: 1500;
            display: none;
        }

        .file-menu-overlay.show {
            display: flex;
        }

        .file-menu-sidebar {
            width: 280px;
            background: #f3f2f1;
            border-right: 1px solid #edebe9;
            padding: 16px 0;
        }

        .file-menu-item {
            padding: 12px 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            font-size: 14px;
            color: #323130;
            position: relative;
        }

        .file-menu-item:hover {
            background: #e5e5e5;
        }

        .file-menu-item.disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .file-menu-icon {
            width: 20px;
            font-size: 16px;
        }

        .file-menu-arrow {
            margin-left: auto;
            font-size: 18px;
            color: #605e5c;
        }

        .file-menu-content {
            flex: 1;
            padding: 40px 60px;
            overflow-y: auto;
        }

        .file-section {
            max-width: 800px;
        }

        .file-section.hidden {
            display: none;
        }

        .file-section-header h2 {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 24px;
            color: #323130;
        }

        .file-property {
            margin-bottom: 16px;
            padding-bottom: 16px;
            border-bottom: 1px solid #edebe9;
        }

        .file-property-label {
            font-size: 12px;
            color: #605e5c;
            margin-bottom: 4px;
        }

        .file-property-value {
            font-size: 14px;
            color: #323130;
        }

        .file-property-value a {
            color: #d24726;
            text-decoration: none;
        }

        .file-links {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 24px;
        }

        .file-link {
            color: #0078d4;
            text-decoration: none;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .file-link:hover {
            text-decoration: underline;
        }

        .new-options, .open-section, .share-options, .copy-options, .export-options, .print-options {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .new-option, .share-option, .copy-option, .export-option, .print-option {
            padding: 16px;
            border: 1px solid #edebe9;
            border-radius: 4px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 16px;
            background: white;
        }

        .new-option:hover, .share-option:hover, .copy-option:hover, .export-option:hover, .print-option:hover {
            background: #f3f2f1;
            border-color: #d1d1d1;
        }

        .new-option-icon, .share-option-icon, .copy-option-icon, .export-option-icon, .print-option-icon {
            font-size: 24px;
        }

        .new-option-label {
            font-size: 14px;
            font-weight: 500;
        }

        .recent-file, .file-action {
            padding: 12px 16px;
            border: 1px solid #edebe9;
            border-radius: 4px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
            background: white;
        }

        .recent-file:hover, .file-action:hover {
            background: #f3f2f1;
        }

        .recent-file-icon, .file-action-icon {
            font-size: 20px;
        }

        .recent-file-name {
            font-size: 14px;
        }

        .open-section h3 {
            font-size: 16px;
            font-weight: 600;
            margin: 24px 0 12px 0;
            color: #323130;
        }

        .rename-section {
            max-width: 500px;
        }

        .rename-section label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #323130;
        }

        .rename-input {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #8a8886;
            border-radius: 2px;
            font-size: 14px;
        }

        .btn-primary {
            background: #d24726;
            color: white;
            border: none;
            padding: 8px 24px;
            border-radius: 2px;
            font-size: 14px;
            cursor: pointer;
        }

        .btn-primary:hover {
            background: #b93b1d;
        }

        .history-list {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .history-item {
            padding: 16px;
            border: 1px solid #edebe9;
            border-radius: 4px;
            background: white;
            cursor: pointer;
        }

        .history-item:hover {
            background: #f3f2f1;
        }

        .history-time {
            font-size: 14px;
            font-weight: 600;
            color: #323130;
            margin-bottom: 4px;
        }

        .history-author {
            font-size: 13px;
            color: #605e5c;
        }

        .file-menu-close {
            position: absolute;
            top: 16px;
            right: 16px;
            background: transparent;
            border: 1px solid #edebe9;
            padding: 8px 16px;
            border-radius: 2px;
            cursor: pointer;
            font-size: 13px;
            color: #323130;
        }

        .file-menu-close:hover {
            background: #f3f2f1;
        }

        /* Toast notification */
        .ppt-toast {
            position: fixed;
            bottom: 60px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: #323130;
            color: white;
            padding: 12px 24px;
            border-radius: 4px;
            font-size: 14px;
            z-index: 9999;
            opacity: 0;
            transition: all 0.3s ease;
            pointer-events: none;
            white-space: nowrap;
        }
        .ppt-toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        /* Server load modal */
        .ppt-server-modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.4);
            z-index: 3000;
            display: none;
            align-items: center;
            justify-content: center;
        }
        .ppt-server-modal-overlay.show {
            display: flex;
        }
        .ppt-server-modal {
            background: white;
            border-radius: 8px;
            padding: 24px;
            width: 420px;
            max-height: 70vh;
            overflow-y: auto;
            box-shadow: 0 8px 32px rgba(0,0,0,0.2);
        }
        .ppt-server-modal h3 {
            margin: 0 0 16px 0;
            font-size: 18px;
            color: #323130;
        }
        .ppt-server-modal-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px;
            border: 1px solid #edebe9;
            border-radius: 4px;
            margin-bottom: 8px;
            cursor: pointer;
        }
        .ppt-server-modal-item:hover {
            background: #f3f2f1;
            border-color: #d24726;
        }
        .ppt-server-modal-item span {
            flex: 1;
            font-size: 14px;
        }
        .ppt-server-modal-item .delete-btn {
            background: none;
            border: none;
            color: #a4262c;
            cursor: pointer;
            font-size: 14px;
            padding: 4px 8px;
        }
        .ppt-server-modal-item .delete-btn:hover {
            background: #fde7e9;
            border-radius: 2px;
        }
        .ppt-server-modal-close {
            margin-top: 12px;
            padding: 8px 16px;
            border: 1px solid #edebe9;
            background: white;
            border-radius: 2px;
            cursor: pointer;
            font-size: 13px;
        }
        .ppt-server-modal-close:hover {
            background: #f3f2f1;
        }

        /* Comments panel */
        .comments-panel {
            position: fixed;
            top: 0; right: -340px; bottom: 0;
            width: 340px;
            background: white;
            box-shadow: -4px 0 16px rgba(0,0,0,0.15);
            z-index: 5000;
            transition: right 0.3s ease;
            display: flex;
            flex-direction: column;
        }
        .comments-panel.open { right: 0; }
        .comments-panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px;
            border-bottom: 1px solid #edebe9;
            font-weight: 600;
            font-size: 16px;
        }
        .comments-panel-header button {
            background: transparent;
            border: none;
            font-size: 18px;
            cursor: pointer;
            color: #605e5c;
            padding: 4px 8px;
            border-radius: 4px;
        }
        .comments-panel-header button:hover { background: #f3f2f1; }
        .comments-panel-body {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
        }
        .comment-item {
            padding: 12px;
            border: 1px solid #edebe9;
            border-radius: 6px;
            margin-bottom: 8px;
        }
        .comment-item .comment-meta {
            font-size: 12px;
            color: #605e5c;
            margin-bottom: 4px;
        }
        .comment-item .comment-text {
            font-size: 14px;
        }
        .comments-panel-footer {
            padding: 12px;
            border-top: 1px solid #edebe9;
            display: flex;
            gap: 8px;
        }
        .comments-panel-footer input {
            flex: 1;
            padding: 8px 12px;
            border: 1px solid #edebe9;
            border-radius: 4px;
            font-size: 14px;
            outline: none;
        }
        .comments-panel-footer input:focus { border-color: #d24726; }
        .comments-panel-footer button {
            padding: 8px 16px;
            background: #d24726;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
        }
        .comments-panel-footer button:hover { background: #b83d20; }
        .comments-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.3);
            z-index: 4999;
            display: none;
        }
        .comments-overlay.open { display: block; }

        /* Share modal */
        .share-modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.4);
            z-index: 6000;
            display: none;
            align-items: center;
            justify-content: center;
        }
        .share-modal-overlay.open { display: flex; }
        .share-modal {
            background: white;
            border-radius: 8px;
            width: 480px;
            max-width: 90vw;
            padding: 24px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.2);
        }
        .share-modal h3 { margin-bottom: 16px; font-size: 18px; }
        .share-modal .share-link-box {
            display: flex;
            gap: 8px;
            margin-bottom: 16px;
        }
        .share-modal .share-link-box input {
            flex: 1;
            padding: 10px 12px;
            border: 1px solid #edebe9;
            border-radius: 4px;
            font-size: 14px;
            background: #f3f2f1;
        }
        .share-modal .share-link-box button {
            padding: 10px 16px;
            background: #d24726;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .share-modal .share-close {
            display: block;
            margin: 12px auto 0;
            padding: 8px 24px;
            border: 1px solid #edebe9;
            background: white;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
        }

        /* Mobile bars - hidden by default on desktop */
        .ppt-mobile-title-bar {
            display: none;
        }
        .ppt-mobile-bottom-bar {
            display: none;
        }

        /* Mobile menu overlay */
        .ppt-mobile-menu-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.4);
            z-index: 4000;
            display: none;
        }
        .ppt-mobile-menu-overlay.show {
            display: block;
        }
        .ppt-mobile-menu {
            position: absolute;
            top: 0; right: 0; bottom: 0;
            width: 280px;
            background: white;
            padding: 16px 0;
            overflow-y: auto;
            box-shadow: -4px 0 16px rgba(0,0,0,0.15);
        }
        .ppt-mobile-menu-item {
            padding: 14px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            font-size: 15px;
            color: #323130;
        }
        .ppt-mobile-menu-item:hover, .ppt-mobile-menu-item:active {
            background: #f3f2f1;
        }
        .ppt-mobile-menu-item i {
            width: 20px;
            text-align: center;
            color: #605e5c;
        }

        /* Mobile slide-in thumbnails panel */
        .ppt-mobile-thumbs-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.4);
            z-index: 3500;
            display: none;
        }
        .ppt-mobile-thumbs-overlay.show {
            display: block;
        }
        .ppt-mobile-thumbs-panel {
            position: absolute;
            top: 0; left: 0; bottom: 0;
            width: 220px;
            background: #f3f2f1;
            padding: 0 0 80px;
            overflow-y: auto;
            box-shadow: 4px 0 16px rgba(0,0,0,0.15);
            display: flex;
            flex-direction: column;
        }
        .ppt-mobile-thumbs-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px;
            background: #d24726;
            color: white;
            font-weight: 600;
            font-size: 15px;
            position: sticky;
            top: 0;
            z-index: 1;
        }
        .ppt-mobile-thumbs-header button {
            background: transparent;
            border: none;
            color: white;
            font-size: 18px;
            padding: 4px 8px;
            cursor: pointer;
            border-radius: 4px;
        }
        .ppt-mobile-thumbs-header button:active {
            background: rgba(255,255,255,0.2);
        }
        .ppt-mobile-thumbs-actions {
            display: flex;
            gap: 4px;
            padding: 8px;
            background: white;
            border-bottom: 1px solid #edebe9;
        }
        .ppt-mobile-thumbs-actions button {
            flex: 1;
            padding: 8px 4px;
            border: 1px solid #edebe9;
            background: white;
            border-radius: 4px;
            font-size: 12px;
            color: #323130;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
        }
        .ppt-mobile-thumbs-actions button:active {
            background: #edebe9;
        }
        .ppt-mobile-thumbs-actions button i {
            font-size: 16px;
            color: #d24726;
        }
        .ppt-mobile-thumbs-list {
            flex: 1;
            overflow-y: auto;
            padding: 8px;
        }
        .ppt-mobile-thumbs-panel .slide-thumb {
            margin-bottom: 8px;
            position: relative;
            border: 2px solid transparent;
            border-radius: 4px;
            background: white;
            padding: 4px;
        }
        .ppt-mobile-thumbs-panel .slide-thumb.active {
            border-color: #d24726;
        }
        .ppt-mobile-thumb-actions {
            position: absolute;
            top: 4px;
            right: 4px;
            display: flex;
            gap: 2px;
            opacity: 0;
            transition: opacity 0.15s;
        }
        .ppt-mobile-thumbs-panel .slide-thumb:active .ppt-mobile-thumb-actions,
        .ppt-mobile-thumbs-panel .slide-thumb .ppt-mobile-thumb-actions {
            opacity: 1;
        }
        .ppt-mobile-thumb-actions button {
            width: 24px;
            height: 24px;
            border: none;
            background: rgba(0,0,0,0.5);
            color: white;
            border-radius: 3px;
            font-size: 11px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .ppt-mobile-thumb-actions button:active {
            background: rgba(0,0,0,0.7);
        }

        /* Resize handles touch */
        .resize-handle {
            position: absolute;
            width: 20px;
            height: 20px;
            background: #d24726;
            border: 2px solid white;
            border-radius: 50%;
            z-index: 10;
            display: none;
            touch-action: none;
        }
        .slide-element.selected .resize-handle {
            display: block;
        }
        .resize-handle-se { right: -10px; bottom: -10px; cursor: nwse-resize; }
        .resize-handle-sw { left: -10px; bottom: -10px; cursor: nesw-resize; }
        .resize-handle-ne { right: -10px; top: -10px; cursor: nesw-resize; }
        .resize-handle-nw { left: -10px; top: -10px; cursor: nwse-resize; }

        /* =========== MOBILE RESPONSIVE =========== */
        @media (max-width: 768px) {
            body {
                overflow: auto;
            }
            .top-bar, .ribbon-tabs, .ribbon-content, .bottom-bar {
                display: none !important;
            }
            .ppt-mobile-title-bar {
                display: flex !important;
                align-items: center;
                background: #d24726;
                color: white;
                height: 48px;
                padding: 0 8px;
                gap: 6px;
                position: sticky;
                top: 0;
                z-index: 100;
            }
            .ppt-mobile-title-bar a {
                color: white;
                text-decoration: none;
                font-size: 20px;
                padding: 6px;
                display: flex;
                align-items: center;
            }
            .ppt-mobile-title-bar .ppt-mob-title {
                flex: 1;
                background: transparent;
                border: none;
                color: white;
                font-size: 15px;
                font-weight: 600;
                padding: 4px 8px;
                outline: none;
                min-width: 0;
            }
            .ppt-mobile-title-bar .ppt-mob-title::placeholder {
                color: rgba(255,255,255,0.7);
            }
            .ppt-mobile-title-bar button {
                background: transparent;
                border: none;
                color: white;
                font-size: 18px;
                padding: 6px 8px;
                cursor: pointer;
                border-radius: 4px;
            }
            .ppt-mobile-title-bar button:active {
                background: rgba(255,255,255,0.2);
            }
            .ppt-mobile-bottom-bar {
                display: flex !important;
                align-items: center;
                background: white;
                border-top: 1px solid #edebe9;
                height: 48px;
                padding: 0 4px;
                gap: 2px;
                overflow-x: auto;
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                z-index: 100;
                -webkit-overflow-scrolling: touch;
            }
            .ppt-mobile-bottom-bar button {
                background: transparent;
                border: none;
                font-size: 18px;
                padding: 8px 10px;
                cursor: pointer;
                border-radius: 4px;
                color: #323130;
                white-space: nowrap;
                flex-shrink: 0;
            }
            .ppt-mobile-bottom-bar button:active {
                background: #edebe9;
            }
            .ppt-mobile-bottom-bar input[type="color"] {
                width: 32px;
                height: 32px;
                border: 1px solid #edebe9;
                cursor: pointer;
                border-radius: 4px;
                flex-shrink: 0;
                padding: 2px;
            }
            .ppt-mobile-bottom-bar .mob-sep {
                width: 1px;
                height: 28px;
                background: #edebe9;
                flex-shrink: 0;
            }
            .workspace {
                flex-direction: column;
                height: auto;
                min-height: calc(100vh - 48px - 48px);
            }
            .thumbnails-panel {
                display: none !important;
            }
            .designer-panel {
                display: none !important;
            }
            .canvas-area {
                flex: 1;
                padding: 8px;
                align-items: stretch;
                overflow: visible;
            }
            .slide-canvas {
                width: 100% !important;
                height: auto !important;
                aspect-ratio: 16 / 9;
                top: 0;
                transform: none !important;
                box-shadow: 0 2px 8px rgba(0,0,0,0.12);
            }
            .slide-element {
                touch-action: none;
            }
            .file-menu-overlay {
                top: 0;
            }
            .file-menu-sidebar {
                width: 200px;
            }
            .file-menu-content {
                padding: 20px;
            }
            .ppt-server-modal {
                width: calc(100vw - 32px);
            }
            .comments-panel {
                width: 280px;
            }
            .share-modal {
                width: calc(100vw - 32px);
            }
            .resize-handle {
                width: 24px;
                height: 24px;
            }
            .resize-handle-se { right: -12px; bottom: -12px; }
            .resize-handle-sw { left: -12px; bottom: -12px; }
            .resize-handle-ne { right: -12px; top: -12px; }
            .resize-handle-nw { left: -12px; top: -12px; }
        }
    </style>
</head>
<body>
    <!-- Mobile Title Bar -->
    <div class="ppt-mobile-title-bar">
        <a href="../index.html"><i class="fas fa-arrow-left"></i></a>
        <input type="text" class="ppt-mob-title" id="mobDocTitle" value="Presentation 1" placeholder="Nome presentazione" oninput="presentation.name=this.value; document.getElementById('docTitle').value=this.value;">
        <button onclick="undo()" title="Annulla"><i class="fas fa-undo"></i></button>
        <button onclick="redo()" title="Ripristina"><i class="fas fa-redo"></i></button>
        <button onclick="OfficeLauncher.toggle()" title="App"><i class="fas fa-th"></i></button>
        <button onclick="toggleMobileMenu()" title="Menu"><i class="fas fa-ellipsis-v"></i></button>
    </div>

    <!-- Top bar -->
    <div class="top-bar">
        <button class="waffle-btn" onclick="OfficeLauncher.toggle()" title="App Office Suite" style="color:#605e5c;"><div class="waffle-grid"><span class="waffle-dot"></span><span class="waffle-dot"></span><span class="waffle-dot"></span><span class="waffle-dot"></span><span class="waffle-dot"></span><span class="waffle-dot"></span><span class="waffle-dot"></span><span class="waffle-dot"></span><span class="waffle-dot"></span></div></button>
        <div class="app-icon">P</div>
        <input type="text" class="doc-title" value="Presentation 1" id="docTitle" title="Nome presentazione">
        <div class="save-status">
            <span>🔄</span>
            <span>Salvato</span>
        </div>

        <div class="top-right">
            <div class="search-box">
                <span>🔍</span>
                <input type="text" placeholder="Cerca" title="Cerca nella presentazione">
            </div>
            <button class="icon-btn" onclick="showToast('Nessuna nuova notifica')" title="Notifiche">🔔</button>
            <button class="icon-btn" onclick="showSettings()" title="Impostazioni">⚙️</button>
            <button class="top-btn" onclick="toggleCommentsPanel()" title="Mostra/Nascondi commenti">💬 Commenti</button>
            <button class="top-btn" onclick="checkForUpdates()" title="Controlla aggiornamenti">🔄 Aggiornamento</button>
            <button class="top-btn" onclick="startSlideshow()" title="Avvia presentazione">📊 Presenta</button>
            <button class="top-btn" onclick="toggleEditMode()" title="Attiva/Disattiva modalità modifica">✏️ Modifica</button>
            <button class="top-btn primary" onclick="sharePresentation()" title="Condividi presentazione">Condividi</button>
            <div class="user-icon">DD</div>
        </div>
    </div>

    <!-- App Launcher gestito da shared/app-launcher.js -->

    <!-- File Menu Overlay -->
    <div class="file-menu-overlay" id="fileMenuOverlay">
        <div class="file-menu-sidebar">
            <div class="file-menu-item" onclick="showFileSection('info')">
                <span class="file-menu-icon">ℹ️</span>
                <span>Informazioni</span>
                <span class="file-menu-arrow">›</span>
            </div>
            <div class="file-menu-item" onclick="showFileSection('new')">
                <span class="file-menu-icon">➕</span>
                <span>Nuovo</span>
                <span class="file-menu-arrow">›</span>
            </div>
            <div class="file-menu-item" onclick="showFileSection('open')">
                <span class="file-menu-icon">📁</span>
                <span>Apri</span>
                <span class="file-menu-arrow">›</span>
            </div>
            <div class="file-menu-item" onclick="showFileSection('share')">
                <span class="file-menu-icon">🔗</span>
                <span>Condividi</span>
                <span class="file-menu-arrow">›</span>
            </div>
            <div class="file-menu-item" onclick="showFileSection('copy')">
                <span class="file-menu-icon">📄</span>
                <span>Crea una copia</span>
                <span class="file-menu-arrow">›</span>
            </div>
            <div class="file-menu-item" onclick="showFileSection('export')">
                <span class="file-menu-icon">📤</span>
                <span>esportazione</span>
                <span class="file-menu-arrow">›</span>
            </div>
            <div class="file-menu-item" onclick="showFileSection('print')">
                <span class="file-menu-icon">🖨️</span>
                <span>Stampa</span>
                <span class="file-menu-arrow">›</span>
            </div>
            <div class="file-menu-item" onclick="showFileSection('rename')">
                <span class="file-menu-icon">✏️</span>
                <span>Rinomina</span>
            </div>
            <div class="file-menu-item disabled">
                <span class="file-menu-icon">📧</span>
                <span>Sposta file</span>
            </div>
            <div class="file-menu-item" onclick="showFileSection('history')">
                <span class="file-menu-icon">🕐</span>
                <span>Cronologia versioni</span>
            </div>
        </div>

        <div class="file-menu-content" id="fileMenuContent">
            <!-- Info Section -->
            <div class="file-section" id="section-info">
                <div class="file-section-header">
                    <h2>Proprietà del file</h2>
                </div>
                <div class="file-property">
                    <div class="file-property-label">Luogo</div>
                    <div class="file-property-value">
                        <a href="#">OneDrive</a> › <a href="#">Documents</a>
                    </div>
                </div>
                <div class="file-property">
                    <div class="file-property-label">ID sessione</div>
                    <div class="file-property-value">477e1d66-ff2d-4967-b4e5-2689b857b012</div>
                </div>
                <div class="file-property">
                    <div class="file-property-label">Build</div>
                    <div class="file-property-value">16.0.19503.40509</div>
                </div>
                <div class="file-links">
                    <a href="#" class="file-link">📄 Condizioni d'uso</a>
                    <a href="#" class="file-link">📄 Comunicazioni di terze parti</a>
                    <a href="#" class="file-link">📄 Criteri sui dati sanitari dei consumatori</a>
                    <a href="#" class="file-link">🍪 Privacy e cookie</a>
                </div>
            </div>

            <!-- New Section -->
            <div class="file-section hidden" id="section-new">
                <div class="file-section-header">
                    <h2>Nuovo</h2>
                </div>
                <div class="new-options">
                    <div class="new-option" onclick="addSlide(); closeFileMenu();">
                        <div class="new-option-icon">📄</div>
                        <div class="new-option-label">Presentazione vuota</div>
                    </div>
                    <div class="new-option">
                        <div class="new-option-icon">📋</div>
                        <div class="new-option-label">Sfoglia modelli</div>
                    </div>
                </div>
            </div>

            <!-- Open Section -->
            <div class="file-section hidden" id="section-open">
                <div class="file-section-header">
                    <h2>Apri</h2>
                </div>
                <div class="open-section">
                    <h3>Aperti di recente</h3>
                    <div class="recent-file" onclick="document.getElementById('fileInput').click(); closeFileMenu();">
                        <span class="recent-file-icon">📄</span>
                        <span class="recent-file-name">Presentation 1.pptx</span>
                    </div>
                    <div class="recent-file" onclick="document.getElementById('fileInput').click(); closeFileMenu();">
                        <span class="recent-file-icon">📄</span>
                        <span class="recent-file-name">Presentation.pptx</span>
                    </div>
                    <div class="file-action" onclick="document.getElementById('fileInput').click(); closeFileMenu();">
                        <span class="file-action-icon">📂</span>
                        <span>Visualizza tutti i file</span>
                    </div>
                    <div class="file-action" onclick="document.getElementById('fileInput').click(); closeFileMenu();">
                        <span class="file-action-icon">💻</span>
                        <span>Apri file da questo dispositivo</span>
                    </div>
                    <div class="file-action" onclick="loadFromServerList(); closeFileMenu();">
                        <span class="file-action-icon">☁️</span>
                        <span>Carica dal server</span>
                    </div>
                </div>
            </div>

            <!-- Share Section -->
            <div class="file-section hidden" id="section-share">
                <div class="file-section-header">
                    <h2>Condividi</h2>
                </div>
                <div class="share-options">
                    <div class="share-option" onclick="sharePresentation(); closeFileMenu();" style="cursor:pointer;">
                        <span class="share-option-icon">👥</span>
                        <span>Condividi con le persone</span>
                    </div>
                    <div class="share-option" onclick="copyShareLinkDirect(); closeFileMenu();" style="cursor:pointer;">
                        <span class="share-option-icon">🔗</span>
                        <span>Copia collegamento a questa presentazione</span>
                    </div>
                    <div class="share-option" onclick="embedPresentation(); closeFileMenu();" style="cursor:pointer;">
                        <span class="share-option-icon">💻</span>
                        <span>Incorpora questa presentazione</span>
                    </div>
                    <div class="share-option" onclick="showToast('Accesso: solo tu puoi modificare'); closeFileMenu();" style="cursor:pointer;">
                        <span class="share-option-icon">⚙️</span>
                        <span>Gestisci accesso</span>
                    </div>
                </div>
            </div>

            <!-- Copy Section -->
            <div class="file-section hidden" id="section-copy">
                <div class="file-section-header">
                    <h2>Crea una copia</h2>
                </div>
                <div class="copy-options">
                    <div class="copy-option" onclick="downloadPresentation(); closeFileMenu();">
                        <span class="copy-option-icon">☁️</span>
                        <span>Crea una copia online</span>
                    </div>
                    <div class="copy-option" onclick="downloadPresentation(); closeFileMenu();">
                        <span class="copy-option-icon">⬇️</span>
                        <span>Scarica una copia</span>
                    </div>
                </div>
            </div>

            <!-- Export Section -->
            <div class="file-section hidden" id="section-export">
                <div class="file-section-header">
                    <h2>Esportazione</h2>
                </div>
                <div class="export-options">
                    <div class="export-option" onclick="exportAsPDF(); closeFileMenu();">
                        <span class="export-option-icon">📄</span>
                        <span>Scarica come PDF</span>
                    </div>
                    <div class="export-option" onclick="exportAsODP(); closeFileMenu();">
                        <span class="export-option-icon">📊</span>
                        <span>Esporta in ODP</span>
                    </div>
                    <div class="export-option" onclick="exportAsImage(); closeFileMenu();">
                        <span class="export-option-icon">🖼️</span>
                        <span>Esporta come immagine</span>
                    </div>
                    <div class="export-option" onclick="saveToServer(); closeFileMenu();">
                        <span class="export-option-icon">☁️</span>
                        <span>Salva sul server</span>
                    </div>
                </div>
            </div>

            <!-- Print Section -->
            <div class="file-section hidden" id="section-print">
                <div class="file-section-header">
                    <h2>Stampa</h2>
                </div>
                <div class="print-options">
                    <div class="print-option" onclick="printPresentation(); closeFileMenu();">
                        <span class="print-option-icon">🖨️</span>
                        <span>Stampa diapositive a pagina intera</span>
                    </div>
                    <div class="print-option" onclick="printPresentation(); closeFileMenu();">
                        <span class="print-option-icon">📝</span>
                        <span>Stampa diapositive con note</span>
                    </div>
                    <div class="print-option" onclick="printPresentation(); closeFileMenu();">
                        <span class="print-option-icon">📋</span>
                        <span>Stampa stampati</span>
                    </div>
                </div>
            </div>

            <!-- Rename Section -->
            <div class="file-section hidden" id="section-rename">
                <div class="file-section-header">
                    <h2>Rinomina</h2>
                </div>
                <div class="rename-section">
                    <label>Nome file</label>
                    <input type="text" class="rename-input" value="Presentation 1" id="renameInput">
                    <div style="margin-top: 8px; font-size: 12px; color: #605e5c;">.pptx</div>
                    <div style="margin-top: 16px;">
                        <label>Luogo</label>
                        <div style="margin-top: 8px; padding: 8px; border: 1px solid #edebe9; border-radius: 2px;">
                            <a href="#" style="color: #d24726;">OneDrive</a> › <a href="#" style="color: #d24726;">Documents</a>
                        </div>
                    </div>
                    <button class="btn-primary" onclick="renamePresentation(); closeFileMenu();" style="margin-top: 16px;">Salva</button>
                </div>
            </div>

            <!-- History Section -->
            <div class="file-section hidden" id="section-history">
                <div class="file-section-header">
                    <h2>Cronologia versioni</h2>
                </div>
                <div class="history-list">
                    <div class="history-item">
                        <div class="history-time">Oggi alle 14:30</div>
                        <div class="history-author">Modificato da te</div>
                    </div>
                    <div class="history-item">
                        <div class="history-time">Ieri alle 10:15</div>
                        <div class="history-author">Modificato da te</div>
                    </div>
                </div>
            </div>
        </div>

        <button class="file-menu-close" onclick="closeFileMenu()">✕ Chiudi</button>
    </div>

    <!-- Ribbon tabs -->
    <div class="ribbon-tabs">
        <div class="ribbon-tab" id="tab-file" onclick="toggleFileMenu()">File</div>
        <div class="ribbon-tab active" id="tab-home" onclick="switchTab('home')">Home</div>
        <div class="ribbon-tab" id="tab-insert" onclick="switchTab('insert')">Inserisci</div>
        <div class="ribbon-tab" id="tab-design" onclick="switchTab('design')">Disegno</div>
        <div class="ribbon-tab" id="tab-layout" onclick="switchTab('layout')">Progettazione</div>
        <div class="ribbon-tab" id="tab-transitions" onclick="switchTab('transitions')">Transizioni</div>
        <div class="ribbon-tab" id="tab-animations" onclick="switchTab('animations')">Animazioni</div>
        <div class="ribbon-tab" id="tab-slideshow" onclick="switchTab('slideshow')">Presentazione</div>
        <div class="ribbon-tab" id="tab-review" onclick="switchTab('review')">Revisione</div>
        <div class="ribbon-tab" id="tab-view" onclick="switchTab('view')">Visualizza</div>
        <div class="ribbon-tab" id="tab-help" onclick="switchTab('help')">Guida</div>
    </div>

    <!-- Ribbon Home -->
    <div class="ribbon-content" id="ribbon-home">
        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="addSlide()" title="Aggiungi nuova diapositiva">
                    <div class="ribbon-btn-icon">📄</div>
                    <div>Nuova<br>diapositiva</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="cutElement()" title="Taglia (Ctrl+X)">
                    <div class="ribbon-btn-icon">✂️</div>
                    <div>Taglia</div>
                </button>
                <button class="ribbon-btn small" onclick="copyElement()" title="Copia (Ctrl+C)">
                    <div class="ribbon-btn-icon">📋</div>
                    <div>Copia</div>
                </button>
                <button class="ribbon-btn small" onclick="pasteElement()" title="Incolla (Ctrl+V)">
                    <div class="ribbon-btn-icon">📄</div>
                    <div>Incolla</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <select onchange="changeFontFamily(this.value)" style="width: 140px;" title="Seleziona carattere">
                    <option>Calibri</option>
                    <option>Arial</option>
                    <option>Times New Roman</option>
                    <option>Verdana</option>
                    <option>Georgia</option>
                </select>
                <select onchange="changeFontSize(this.value)" style="width: 60px;" title="Dimensione carattere">
                    <option value="10">10</option>
                    <option value="12">12</option>
                    <option value="14">14</option>
                    <option value="16">16</option>
                    <option value="18" selected>18</option>
                    <option value="20">20</option>
                    <option value="24">24</option>
                    <option value="28">28</option>
                    <option value="32">32</option>
                    <option value="36">36</option>
                    <option value="44">44</option>
                </select>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="formatText('bold')" title="Grassetto (Ctrl+B)">
                    <div class="ribbon-btn-icon"><strong>B</strong></div>
                </button>
                <button class="ribbon-btn small" onclick="formatText('italic')" title="Corsivo (Ctrl+I)">
                    <div class="ribbon-btn-icon"><em>I</em></div>
                </button>
                <button class="ribbon-btn small" onclick="formatText('underline')" title="Sottolineato (Ctrl+U)">
                    <div class="ribbon-btn-icon"><u>U</u></div>
                </button>
                <button class="ribbon-btn small" onclick="formatText('strikeThrough')" title="Barrato">
                    <div class="ribbon-btn-icon">S</div>
                </button>
                <button class="ribbon-btn small" onclick="highlightText()" title="Evidenzia testo">
                    <div class="ribbon-btn-icon">🎨</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="alignText('left')" title="Allinea a sinistra">
                    <div class="ribbon-btn-icon">≡</div>
                </button>
                <button class="ribbon-btn small" onclick="alignText('center')" title="Centra">
                    <div class="ribbon-btn-icon">⋮</div>
                </button>
                <button class="ribbon-btn small" onclick="toggleBullets()" title="Elenco puntato">
                    <div class="ribbon-btn-icon">📋</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="addTextBox()" title="Inserisci casella di testo">
                    <div class="ribbon-btn-icon">📝</div>
                    <div>Casella<br>di testo</div>
                </button>
                <button class="ribbon-btn" onclick="addShape('rectangle')" title="Inserisci forma">
                    <div class="ribbon-btn-icon">▭</div>
                    <div>Forme</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="document.getElementById('imageUpload').click()" title="Inserisci immagine">
                    <div class="ribbon-btn-icon">🖼️</div>
                    <div>Immagini</div>
                </button>
                <input type="file" id="imageUpload" accept="image/*" style="display:none" onchange="addImage(event)">
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <input type="color" id="textColor" value="#000000" onchange="changeTextColor(this.value)" title="Colore testo">
                <input type="color" id="bgColor" value="#ffffff" onchange="changeBgColor(this.value)" title="Colore sfondo elemento">
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="deleteSlide()" title="Elimina diapositiva">
                    <div class="ribbon-btn-icon">🗑️</div>
                    <div>Elimina</div>
                </button>
            </div>
        </div>
    </div>

    <!-- Ribbon Inserisci -->
    <div class="ribbon-content hidden" id="ribbon-insert">
        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="addSlide()">
                    <div class="ribbon-btn-icon">📄</div>
                    <div>Nuova<br>diapositiva</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
