                    <div class="ribbon-btn-icon">♿</div>
                    <div>Verifica<br>accessibilità</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="showToast('Tutti i commenti segnati come letti')">
                    <div class="ribbon-btn-icon">✓</div>
                    <div>Segna tutti<br>come già letti</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="showToast('Nessuna modifica da mostrare')">
                    <div class="ribbon-btn-icon">📝</div>
                    <div>Mostra<br>modifiche</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="toggleCommentsPanel()">
                    <div class="ribbon-btn-icon">💬</div>
                    <div>Nuovo<br>commento</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="deleteAllComments()">
                    <div class="ribbon-btn-icon">🗑️</div>
                    <div>Elimina tutti</div>
                </button>
                <button class="ribbon-btn small" onclick="navigateComment(-1)">
                    <div class="ribbon-btn-icon">⬅️</div>
                    <div>Indietro</div>
                </button>
                <button class="ribbon-btn small" onclick="navigateComment(1)">
                    <div class="ribbon-btn-icon">➡️</div>
                    <div>Avanti</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="toggleCommentsPanel()">
                    <div class="ribbon-btn-icon">💬</div>
                    <div>Mostra<br>commenti</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="searchInSlides()">
                    <div class="ribbon-btn-icon">🔍</div>
                    <div>Cerca</div>
                </button>
            </div>
        </div>
    </div>

    <!-- Ribbon Visualizza -->
    <div class="ribbon-content hidden" id="ribbon-view">
        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="toggleNotes()">
                    <div class="ribbon-btn-icon">📄</div>
                    <div>Note</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="toggleRuler()">
                    <div class="ribbon-btn-icon">📊</div>
                    <div>Righello</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="toggleSlideSorter()">
                    <div class="ribbon-btn-icon">⊞</div>
                    <div>Sequenza<br>diapositive</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="setViewNormal()">
                    <div class="ribbon-btn-icon">📐</div>
                    <div>Normale</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="zoomDialog()">
                    <div class="ribbon-btn-icon">🔍</div>
                    <div>Zoom</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="fitToWindow()">
