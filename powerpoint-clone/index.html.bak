            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="insertAudio()">
                    <div class="ribbon-btn-icon">🔊</div>
                    <div>Audio</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="addShape('rectangle')">
                    <div class="ribbon-btn-icon">▭</div>
                    <div>Forme</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="document.getElementById('imageUpload').click()">
                    <div class="ribbon-btn-icon">📷</div>
                    <div>Immagini di<br>archivio</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="insertIcon()">
                    <div class="ribbon-btn-icon">🎨</div>
                    <div>Icone</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="insertSmartArt()">
                    <div class="ribbon-btn-icon">💡</div>
                    <div>SmartArt</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="insertChart()">
                    <div class="ribbon-btn-icon">📈</div>
                    <div>Grafico</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="insertLink()">
                    <div class="ribbon-btn-icon">🔗</div>
                    <div>Collegamento</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="toggleCommentsPanel()">
                    <div class="ribbon-btn-icon">💬</div>
                    <div>Nuovo<br>commento</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="insertFooter()">
                    <div class="ribbon-btn-icon">📄</div>
                    <div>Piè di<br>pagina</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="insertSymbol()">
                    <div class="ribbon-btn-icon">🔣</div>
