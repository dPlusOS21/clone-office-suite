    <!-- Ribbon Disegno -->
    <div class="ribbon-content hidden" id="ribbon-design">
        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="undo()">
                    <div class="ribbon-btn-icon">↩️</div>
                    <div>Annulla</div>
                </button>
                <button class="ribbon-btn small" onclick="redo()">
                    <div class="ribbon-btn-icon">↪️</div>
                    <div>Ripeti</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="setDrawTool('pencil')" id="drawPencil">
                    <div class="ribbon-btn-icon">✏️</div>
                </button>
                <button class="ribbon-btn small" onclick="setDrawTool('marker')" id="drawMarker">
                    <div class="ribbon-btn-icon">🖍️</div>
                </button>
                <button class="ribbon-btn small" onclick="setDrawTool('pen')" id="drawPen">
                    <div class="ribbon-btn-icon">🖊️</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <input type="color" value="#000000" onchange="drawColor=this.value" title="Colore disegno" style="width:28px;height:28px;border:1px solid #ccc;cursor:pointer;">
                <select onchange="drawWidth=parseInt(this.value)" style="width:60px;padding:2px;">
                    <option value="2">Sottile</option>
                    <option value="4" selected>Medio</option>
                    <option value="8">Spesso</option>
                    <option value="16">Largo</option>
                </select>
                <button class="ribbon-btn small" onclick="clearDrawing()">
                    <div class="ribbon-btn-icon">🗑️</div>
                    <div>Cancella</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="setDrawTool(null)">
                    <div class="ribbon-btn-icon">🔍</div>
                    <div>Seleziona</div>
                </button>
            </div>
        </div>
    </div>

    <!-- Ribbon Progettazione -->
    <div class="ribbon-content hidden" id="ribbon-layout">
        <div class="ribbon-group">
            <div class="ribbon-group-content" style="gap: 8px;">
                <div style="width: 120px; height: 70px; border: 1px solid #ccc; background: white; cursor:pointer;" onclick="applyTheme('#ffffff')"></div>
                <div style="width: 120px; height: 70px; border: 1px solid #ccc; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); cursor:pointer;" onclick="applyTheme('linear-gradient(135deg, #667eea 0%, #764ba2 100%)')"></div>
                <div style="width: 120px; height: 70px; border: 1px solid #ccc; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); cursor:pointer;" onclick="applyTheme('linear-gradient(135deg, #f093fb 0%, #f5576c 100%)')"></div>
                <div style="width: 120px; height: 70px; border: 1px solid #ccc; background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); cursor:pointer;" onclick="applyTheme('linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)')"></div>
            </div>
            <div class="ribbon-group-label">Temi</div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="changeSlideLayout()">
                    <div class="ribbon-btn-icon">📐</div>
                    <div>Layout<br>diapositiva</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="formatSlide()">
                    <div class="ribbon-btn-icon">🎨</div>
                    <div>Formato<br>diapositiva</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="changeBackground()">
                    <div class="ribbon-btn-icon">🖼️</div>
                    <div>Sfondo</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="toggleDesigner()">
                    <div class="ribbon-btn-icon">✨</div>
                    <div>Designer</div>
                </button>
            </div>
        </div>
    </div>

    <!-- Ribbon Transizioni -->
    <div class="ribbon-content hidden" id="ribbon-transitions">
        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="previewTransition()">
                    <div class="ribbon-btn-icon">⏸️</div>
                    <div>Anteprima</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content" style="gap: 8px;">
                <button class="ribbon-btn" style="min-width: 80px;" onclick="setTransition('none')">
                    <div style="width: 60px; height: 40px; border: 1px solid #ccc; background: white;"></div>
                    <div>Nessuna</div>
                </button>
                <button class="ribbon-btn" style="min-width: 80px;" onclick="setTransition('morph')">
                    <div style="width: 60px; height: 40px; border: 1px solid #ccc; background: linear-gradient(to right, white 50%, #4472c4 50%);"></div>
                    <div>Morphing</div>
                </button>
                <button class="ribbon-btn" style="min-width: 80px;" onclick="setTransition('cut')">
                    <div style="width: 60px; height: 40px; border: 1px solid #ccc; background: linear-gradient(45deg, white 30%, #4472c4 30%);"></div>
                    <div>Taglio netto</div>
                </button>
                <button class="ribbon-btn" style="min-width: 80px;" onclick="setTransition('fade')">
                    <div style="width: 60px; height: 40px; border: 1px solid #ccc; background: linear-gradient(to bottom, white 50%, #4472c4 50%);"></div>
                    <div>Dissolvenza</div>
                </button>
                <button class="ribbon-btn" style="min-width: 80px;" onclick="setTransition('push')">
                    <div style="width: 60px; height: 40px; border: 1px solid #ccc; background: #4472c4;"></div>
                    <div>Spinta</div>
                </button>
                <button class="ribbon-btn" style="min-width: 80px;" onclick="setTransition('wipe')">
                    <div style="width: 60px; height: 40px; border: 1px solid #ccc; background: #ed7d31;"></div>
                    <div>Tendina</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <select onchange="setTransitionDirection(this.value)" style="padding:4px;">
                    <option value="left">Da sinistra</option>
                    <option value="right">Da destra</option>
                    <option value="top">Dall'alto</option>
                    <option value="bottom">Dal basso</option>
                </select>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <span style="font-size: 11px; margin-right: 4px;">Durata</span>
                <input type="number" value="0.5" step="0.1" min="0" max="5" id="transitionDuration" onchange="setTransitionDuration(this.value)" style="width: 60px; padding: 4px; border: 1px solid #ccc; border-radius: 2px;">
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="applyTransitionToAll()">
                    <div class="ribbon-btn-icon">✓</div>
                    <div>Applica a<br>tutto</div>
                </button>
            </div>
        </div>
    </div>

    <!-- Ribbon Animazioni -->
    <div class="ribbon-content hidden" id="ribbon-animations">
        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="previewAnimation()">
                    <div class="ribbon-btn-icon">⏸️</div>
                    <div>Anteprima</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="setAnimation('none')">
                    <div class="ribbon-btn-icon">🌟</div>
                    <div>Nessuna</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content" style="gap: 4px;">
                <button class="ribbon-btn" style="min-width: 60px;" onclick="setAnimation('appear')">
                    <div class="ribbon-btn-icon">↗️</div>
                    <div>Comparsa</div>
                </button>
                <button class="ribbon-btn" style="min-width: 60px;" onclick="setAnimation('fadeIn')">
                    <div class="ribbon-btn-icon">💫</div>
                    <div>Dissolvenza</div>
                </button>
                <button class="ribbon-btn" style="min-width: 60px;" onclick="setAnimation('flyIn')">
                    <div class="ribbon-btn-icon">↘️</div>
                    <div>Entrata<br>veloce</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <select onchange="setAnimationOption(this.value)" style="padding:4px;">
                    <option value="left">Da sinistra</option>
                    <option value="right">Da destra</option>
                    <option value="top">Dall'alto</option>
                    <option value="bottom">Dal basso</option>
                </select>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <select id="animStart" onchange="setAnimationStart(this.value)" style="padding:4px;">
                    <option value="click">Al clic</option>
                    <option value="withPrev">Con precedente</option>
                    <option value="afterPrev">Dopo precedente</option>
                </select>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <span style="font-size: 11px;">Durata</span>
                <input type="number" value="0.50" step="0.1" min="0" max="5" id="animDuration" onchange="setAnimationDuration(this.value)" style="width: 60px; padding: 4px;">
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <span style="font-size: 11px;">Ritardo</span>
                <input type="number" value="0.00" step="0.1" min="0" max="10" id="animDelay" onchange="setAnimationDelay(this.value)" style="width: 60px; padding: 4px;">
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn small" onclick="moveAnimationUp()">
                    <div class="ribbon-btn-icon">⬆️</div>
                    <div>Sposta prima</div>
                </button>
                <button class="ribbon-btn small" onclick="moveAnimationDown()">
                    <div class="ribbon-btn-icon">⬇️</div>
                    <div>Sposta dopo</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="toggleAnimationPane()">
                    <div class="ribbon-btn-icon">🎬</div>
                    <div>Riquadro<br>Animazione</div>
                </button>
            </div>
        </div>
    </div>

    <!-- Ribbon Presentazione -->
    <div class="ribbon-content hidden" id="ribbon-slideshow">
        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="startSlideshowFrom(0)">
                    <div class="ribbon-btn-icon">▶️</div>
                    <div>Dall'inizio</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="startSlideshowFrom(presentation.currentSlide)">
                    <div class="ribbon-btn-icon">📄</div>
                    <div>Dalla<br>diapositiva<br>corrente</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="startPresenterView()">
                    <div class="ribbon-btn-icon">📺</div>
                    <div>Visualizzazione<br>Relatore</div>
                </button>
            </div>
        </div>

        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="showToast('Seleziona le diapositive da presentare dalla lista')">
                    <div class="ribbon-btn-icon">📋</div>
                    <div>Personalizzata</div>
                </button>
            </div>
        </div>
    </div>

    <!-- Ribbon Revisione -->
    <div class="ribbon-content hidden" id="ribbon-review">
        <div class="ribbon-group">
            <div class="ribbon-group-content">
                <button class="ribbon-btn" onclick="checkSlide()">
                    <div class="ribbon-btn-icon">📝</div>
                    <div>Controlla<br>diapositiva</div>
                </button>
